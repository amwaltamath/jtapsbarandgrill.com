# Supabase Configuration
PUBLIC_SUPABASE_URL=your-project-url.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Resend Email Marketing
RESEND_API_KEY=your-resend-api-key
# Google Analytics (GA4)
GA4_PROPERTY_ID=your_numeric_property_id

# Focus POS / Shift4 Loyalty (TStream INQUIRY / ADDMEMBER via MyFocus cloud)
# Confirm host letter (gaz/g1/g2) and credentials with Shift4 support for JTAPS (company C=2786).
FOCUS_POS_API_URL=https://gaz.myfocuspos.com/MyFocusGCProcess.asmx/GiftCard
FOCUS_POS_USER_ID=your-focus-user-id
FOCUS_POS_PASSWORD=your-focus-password
FOCUS_POS_MERCHANT_ID=your-merchant-id
FOCUS_POS_MEMO=10.1.250717
FOCUS_POS_OPERATOR_ID=JTAPS-Web
# form = POST urlencoded (default). xml = raw TStream body.
FOCUS_POS_REQUEST_FORMAT=form
# Cloud MyFocus uses xmlData. Local Comm Engine logs may use sendxmlData instead.
FOCUS_POS_XML_PARAM=xmlData
