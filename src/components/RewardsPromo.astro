---
// Rewards program promotion section
---

<section class="rewards-promo">
  <div class="rewards-promo__container">
    <div class="rewards-promo__content">
      <div class="rewards-promo__badge">💳 EARN REWARDS</div>
      <h2>Get Paid to Eat at JTAPS</h2>
      <p class="rewards-promo__highlight">
        For every <strong>$150</strong> you spend, get <strong>$10</strong> back
      </p>
      <p class="rewards-promo__description">
        Join JTAPS Rewards and unlock:
      </p>
      <ul class="rewards-promo__benefits">
        <li>
          <span class="benefit-icon">🎁</span>
          <span><strong>Sign-up bonus</strong> when you join</span>
        </li>
        <li>
          <span class="benefit-icon">🎂</span>
          <span><strong>Birthday bonus</strong> every year</span>
        </li>
        <li>
          <span class="benefit-icon">🏆</span>
          <span><strong>Exclusive coupons</strong> and promotions</span>
        </li>
        <li>
          <span class="benefit-icon">⭐</span>
          <span><strong>Member-only deals</strong> year-round</span>
        </li>
      </ul>
      <div class="rewards-promo__actions">
        <a
          class="rewards-promo__primary"
          href="https://loyalty.focuspos.com/addmember/?C=2786"
          target="_blank"
          rel="noopener"
        >
          Sign Up Now
        </a>
        <a
          class="rewards-promo__secondary"
          href="https://loyalty.focuspos.com/base/?C=2786"
          target="_blank"
          rel="noopener"
        >
          Check Points
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .rewards-promo {
    background: linear-gradient(135deg, #E13622 0%, #ff6b4a 100%);
    padding: 60px 20px;
    margin: 80px 0;
    position: relative;
    overflow: hidden;
  }

  .rewards-promo::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
    background-size: 50px 50px;
    pointer-events: none;
  }

  .rewards-promo__container {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .rewards-promo__content {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 16px;
    padding: 50px 40px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
  }

  .rewards-promo__badge {
    display: inline-block;
    background: #E13622;
    color: white;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-bottom: 20px;
  }

  .rewards-promo__content h2 {
    font-size: 2.4rem;
    color: #1a1a1a;
    margin: 15px 0;
    line-height: 1.2;
  }

  .rewards-promo__highlight {
    font-size: 1.4rem;
    color: #E13622;
    font-weight: 700;
    margin: 20px 0;
    padding: 20px 0;
    border-top: 2px solid #f0f0f0;
    border-bottom: 2px solid #f0f0f0;
  }

  .rewards-promo__description {
    font-size: 1rem;
    color: #555;
    margin: 25px 0 20px;
    font-weight: 600;
  }

  .rewards-promo__benefits {
    list-style: none;
    margin: 25px 0;
    padding: 0;
    text-align: left;
    display: grid;
    gap: 12px;
  }

  .rewards-promo__benefits li {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #333;
    font-size: 1rem;
  }

  .benefit-icon {
    font-size: 1.3rem;
    min-width: 24px;
    text-align: center;
  }

  .rewards-promo__actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 30px;
  }

  .rewards-promo__actions a {
    display: inline-block;
    padding: 14px 32px;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
    font-size: 1rem;
  }

  .rewards-promo__primary {
    background: #E13622;
    color: white;
    box-shadow: 0 10px 25px rgba(225, 54, 34, 0.3);
  }

  .rewards-promo__primary:hover {
    background: #ff6b4a;
    transform: translateY(-2px);
    box-shadow: 0 14px 35px rgba(225, 54, 34, 0.4);
  }

  .rewards-promo__secondary {
    background: white;
    color: #E13622;
    border: 2px solid #E13622;
  }

  .rewards-promo__secondary:hover {
    background: #fff5f2;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .rewards-promo {
      padding: 40px 15px;
      margin: 60px 0;
    }

    .rewards-promo__content {
      padding: 35px 25px;
    }

    .rewards-promo__content h2 {
      font-size: 1.8rem;
    }

    .rewards-promo__highlight {
      font-size: 1.2rem;
    }

    .rewards-promo__benefits {
      text-align: center;
      grid-template-columns: 1fr;
    }

    .rewards-promo__benefits li {
      justify-content: center;
    }

    .rewards-promo__actions a {
      padding: 12px 24px;
      font-size: 0.95rem;
    }
  }

  @media (max-width: 480px) {
    .rewards-promo {
      padding: 30px 15px;
      margin: 50px 0;
    }

    .rewards-promo__content {
      padding: 25px 20px;
    }

    .rewards-promo__content h2 {
      font-size: 1.5rem;
    }

    .rewards-promo__highlight {
      font-size: 1.1rem;
    }

    .rewards-promo__benefits li {
      font-size: 0.95rem;
    }

    .benefit-icon {
      font-size: 1.1rem;
    }
  }
</style>
