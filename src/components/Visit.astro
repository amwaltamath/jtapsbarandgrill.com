---
// Visit section
---

<section class="visit">
  <div class="visit-header">
    <h2>VISIT US</h2>
    <p class="subtitle">OPEN SINCE 2006</p>
  </div>

  <div class="visit-content">
    <div class="visit-card">
      <h3>ENJOY OUTDOOR DINING</h3>
      <p class="location">- JTAPS BAR AND GRILL</p>
    </div>

    <div class="visit-card">
      <h3>COME FOR THE FOOD</h3>
      <p>
        All of your favorites including the best gyros in town. Try our wings and enjoy over 50 TV's to catch all your favorites sports.
      </p>
    </div>

    <div class="visit-card">
      <h3>STAY FOR THE DRINKS</h3>
      <p>New seasonal beers and great bourbon selections!</p>
    </div>

    <div class="visit-highlight">
      <p>
        At JTAPS, we pride ourselves by delivering the best food options at unbeatable prices. Our family fun environment will keep the family coming back for more!
      </p>
    </div>
  </div>

  <div class="rewards-cta">
    <h3>JOIN JTAPS REWARDS</h3>
    <p>Spend $150, get $10 back, plus birthday and sign up bonuses.</p>
    <div class="rewards-actions">
      <a
        class="rewards-primary"
        href="https://loyalty.focuspos.com/addmember/?C=2786"
        target="_blank"
        rel="noopener"
      >
        Sign Up for Rewards
      </a>
      <a
        class="rewards-secondary"
        href="https://loyalty.focuspos.com/base/?C=2786"
        target="_blank"
        rel="noopener"
      >
        Check Your Points
      </a>
    </div>
  </div>
</section>

<style>
  .visit {
    padding: 6rem 2rem;
    background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('/images/6441-Glenway-visit.jpg') center/cover;
    color: var(--text-light);
  }

  .visit-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .visit-header h2 {
    font-size: 3rem;
    color: var(--secondary-color);
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--secondary-color);
    font-weight: bold;
    letter-spacing: 1px;
  }

  .visit-content {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .visit-card {
    padding: 2rem;
    background: rgba(255,255,255,0.05);
    border-radius: 10px;
  }

  .visit-card h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--secondary-color);
  }

  .visit-card p {
    line-height: 1.8;
  }

  .location {
    font-style: italic;
    color: var(--text-light);
  }

  .visit-highlight {
    grid-column: 1 / -1;
    text-align: center;
    font-size: 1.2rem;
    padding: 2rem;
    background: rgba(212, 175, 55, 0.1);
    border-radius: 10px;
  }

  .rewards-cta {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }

  .rewards-cta h3 {
    font-size: 1.5rem;
    margin-bottom: 2rem;
    color: var(--secondary-color);
  }

  .rewards-cta p {
    margin-bottom: 1.5rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .rewards-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .rewards-actions a {
    display: inline-block;
    padding: 1rem;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: bold;
    text-decoration: none;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .rewards-primary {
    background: var(--secondary-color);
    color: var(--primary-color);
  }

  .rewards-secondary {
    background: transparent;
    color: var(--text-light);
    border: 2px solid var(--text-light);
  }

  .rewards-actions a:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.25);
  }

  @media (max-width: 768px) {
    .visit {
      padding: 3rem 1rem;
    }

    .visit-header h2 {
      font-size: 2rem;
    }

    .visit-content {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .visit-card {
      padding: 1.5rem;
    }

    .visit-card h3 {
      font-size: 1.3rem;
    }

    .rewards-actions a {
      min-height: 44px;
      font-size: 1rem;
    }
  }

  @media (max-width: 480px) {
    .visit {
      padding: 2rem 1rem;
    }

    .visit-header h2 {
      font-size: 1.8rem;
    }

    .subtitle {
      font-size: 1rem;
    }

    .visit-card {
      padding: 1.25rem;
    }

    .visit-card h3 {
      font-size: 1.2rem;
    }

    .visit-card p {
      font-size: 0.95rem;
    }

    .rewards-cta h3 {
      font-size: 1.2rem;
    }
  }
</style>
