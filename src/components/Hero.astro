---
// Hero section component
---

<section class="hero">
  <div class="hero-content">
    <h1>JTAPS<br /><span>BAR AND GRILL</span></h1>
    <p class="hero-tagline">
      Cincinnati's favorite spot for game day. Famous Pete's Sauce wings, hand-carved gyros, ice-cold beer, and 50+ TVs. Come taste why locals call us the best wings in Cincinnati — where great food, epic games, and good times collide.
    </p>
    <div class="hero-badges">
      <span class="hero-badge">★ Voted Best Wings in Cincinnati</span>
      <span class="hero-badge">★ 50+ HD TVs</span>
      <span class="hero-badge">★ Since 2006</span>
    </div>
    <div class="cta-group">
      <a href="https://togoorder.com/web/3136#/" target="_blank" class="cta-button">ORDER NOW</a>
      <a
        href="https://loyalty.focuspos.com/addmember/?C=2786"
        target="_blank"
        rel="noopener"
        class="cta-button cta-secondary"
      >
        SIGN UP FOR REWARDS
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/images/6441-Glenway.jpg') center/cover;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--text-light);
    padding: 2rem;
  }

  .hero-content {
    max-width: 900px;
  }

  .hero h1 {
    font-size: 6rem;
    font-weight: 900;
    margin-bottom: 1rem;
    color: var(--secondary-color);
    font-family: 'Bebas Neue', cursive;
    letter-spacing: 3px;
    text-transform: uppercase;
    text-shadow: 3px 3px 6px rgba(0,0,0,0.8);
  }

  .hero h1 span {
    font-size: 4.5rem;
    display: block;
    font-family: 'Righteous', cursive;
    letter-spacing: 2px;
  }

  .hero-tagline {
    font-size: 1.2rem;
    margin-bottom: 1.5rem;
    line-height: 1.8;
    font-weight: 500;
  }

  .hero-badges {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .hero-badge {
    background: rgba(225, 54, 34, 0.9);
    color: #fff;
    padding: 0.4rem 1rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    backdrop-filter: blur(4px);
  }

  .cta-button {
    display: inline-block;
    background: var(--secondary-color);
    color: var(--primary-color);
    padding: 1rem 3rem;
    text-decoration: none;
    font-weight: bold;
    border-radius: 5px;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .cta-group {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .cta-secondary {
    background: transparent;
    color: #ffffff;
    border: 2px solid #ffffff;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(212, 175, 55, 0.3);
  }

  @media (max-width: 1024px) {
    .hero h1 {
      font-size: 4.8rem;
    }

    .hero h1 span {
      font-size: 3.6rem;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 60vh;
      padding: 1.5rem;
    }

    .hero h1 {
      font-size: 3rem;
    }

    .hero h1 span {
      font-size: 2.4rem;
    }

    .hero-tagline {
      font-size: 1rem;
      line-height: 1.6;
    }

    .cta-button {
      padding: 0.8rem 2rem;
      font-size: 0.95rem;
    }
  }

  @media (max-width: 480px) {
    .hero {
      min-height: 50vh;
      padding: 1rem;
    }

    .hero h1 {
      font-size: 2.4rem;
    }

    .hero h1 span {
      font-size: 1.8rem;
    }

    .hero-tagline {
      font-size: 0.9rem;
    }

    .cta-button {
      padding: 0.75rem 1.5rem;
      min-height: 44px;
    }
  }
</style>
