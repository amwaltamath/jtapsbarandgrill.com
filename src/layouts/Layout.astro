---
import Navigation from '../components/Navigation';
import RewardsModal from '../components/RewardsModal.astro';
import '../styles/global.css';
import '../styles/rewards-modal.css';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
}

const { 
  title, 
  description = "JTAPS Bar and Grill - Cincinnati's best sports bar since 2006. Famous wings, hand-carved gyros, juicy burgers, and 50+ TVs for watching the game.",
  keywords = "sports bar cincinnati, best wings cincinnati, gyros cincinnati, watch the game cincinnati, burgers cincinnati, glenway ave restaurant",
  ogImage = "/images/6441-Glenway.jpg"
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={Astro.url} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
    
    <!-- Local Business Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Restaurant",
        "name": "JTAPS Bar and Grill",
        "image": "/images/6441-Glenway.jpg",
        "@id": "https://jtapsbarandgrill.com",
        "url": "https://jtapsbarandgrill.com",
        "telephone": "(513) 574-9777",
        "priceRange": "$$",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "6441 Glenway Ave",
          "addressLocality": "Cincinnati",
          "addressRegion": "OH",
          "postalCode": "45211",
          "addressCountry": "US"
        },
        "servesCuisine": ["American", "Greek", "Bar Food"],
        "hasMenu": "https://jtapsbarandgrill.com/menu",
        "acceptsReservations": "False"
      }
    </script>
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <Navigation client:only="react" />
    </header>
    
    <main>
      <slot />
    </main>
    
    <footer>
      <div class="footer-content">
        <div class="footer-logo">
          <h3>JTAPS</h3>
          <p>BAR AND GRILL EST 2006</p>
        </div>
        <div class="footer-info">
          <p>&copy; {new Date().getFullYear()} JTAPS Bar and Grill. All rights reserved.</p>
            <p style="margin-top:0.5rem;font-size:0.95em;">
              Built by <a href="https://premierdigitalsolution.com" target="_blank" rel="noopener" style="color:#ffd2d2;text-decoration:underline;">Premier Digital Solution</a>
            </p>
        </div>
      </div>
    </footer>
    <RewardsModal />
  </body>
</html>
