---
/**
 * Full-screen beer menu display designed for bar TVs.
 * Auto-refreshes every 60 seconds.
 */
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>JTAPS Beer Menu</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Open Sans', sans-serif;
      background: #111214;
      color: #f0ece4;
      height: 100vh;
      width: 100vw;
      overflow: hidden;
    }

    .tv-wrapper {
      height: 100vh;
      width: 100vw;
      display: flex;
      flex-direction: column;
      padding: 1.5rem 2.5rem 1rem;
    }

    /* ---- Header ---- */
    .tv-header {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.5rem;
      margin-bottom: 1.1rem;
      padding-bottom: 1rem;
      border-bottom: 2px solid #2a2a2a;
      position: relative;
    }

    .tv-header::after {
      content: '';
      position: absolute;
      bottom: -5px;
      left: 10%;
      right: 10%;
      height: 2px;
      background: linear-gradient(90deg, transparent, #E13622 20%, #E13622 80%, transparent);
    }

    .header-icon { font-size: 2.8rem; line-height: 1; }

    .header-text { text-align: center; }

    .tv-header h1 {
      font-family: 'Oswald', sans-serif;
      font-size: 3rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      line-height: 1;
      color: #fff;
    }

    .tv-header h1 .brand { color: #E13622; }

    .tv-header .tagline {
      font-family: 'Oswald', sans-serif;
      font-size: 0.85rem;
      color: #555;
      letter-spacing: 0.35em;
      text-transform: uppercase;
      margin-top: 0.3rem;
    }

    /* ---- Body ---- */
    .tv-body {
      flex: 1;
      min-height: 0;
      overflow: hidden;
    }

    .beer-sections {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      align-content: start;
      gap: 0.6rem;
      transform-origin: top left;
    }

    /* Section heading breaks into its own column line */
    .section-heading {
      grid-column: 1 / -1;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-family: 'Oswald', sans-serif;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.4em;
      text-transform: uppercase;
      color: #E13622;
      padding: 0.4rem 0 0.5rem;
      border-bottom: 1px solid #222;
      margin-bottom: 0.6rem;
    }

    /* First section heading needs no top spacing */
    .section-heading:first-child { padding-top: 0; }

    .section-heading::after {
      content: '';
      flex: 1;
      height: 1px;
      background: #1e1e1e;
    }

    /* Keep each card in one column — never split across columns */
    .beer-card {
      background: #17181a;
      border: 1px solid rgba(255, 255, 255, 0.13);
      border-radius: 8px;
      padding: 0.75rem 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .beer-card.is-featured {
      border-color: rgba(255, 215, 0, 0.45);
      background: #1a1910;
    }

    /* Name + price on same row */
    .beer-card-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .beer-card-name {
      font-family: 'Oswald', sans-serif;
      font-size: 1.25rem;
      font-weight: 600;
      color: #e4e0d8;
      line-height: 1.15;
      flex: 1;
      min-width: 0;
    }

    .beer-card.is-featured .beer-card-name { color: #fff; }

    .beer-card-price {
      font-family: 'Oswald', sans-serif;
      font-size: 1.35rem;
      font-weight: 700;
      color: #666;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .beer-card.is-featured .beer-card-price { color: #FFD700; }

    /* Brewery in muted text */
    .beer-card-brewery {
      font-size: 0.72rem;
      color: #3d3d3f;
      letter-spacing: 0.02em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Style + ABV badges */
    .beer-card-badges {
      display: flex;
      align-items: center;
      gap: 0.3rem;
      margin-top: 0.15rem;
      flex-wrap: wrap;
    }

    .style-badge {
      font-size: 0.6rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #E13622;
      background: rgba(225,54,34,0.08);
      border: 1px solid rgba(225,54,34,0.18);
      border-radius: 3px;
      padding: 0.1rem 0.45rem;
      white-space: nowrap;
    }

    .abv-badge {
      font-size: 0.6rem;
      font-weight: 600;
      color: #555;
      background: rgba(255,255,255,0.03);
      border: 1px solid #272727;
      border-radius: 3px;
      padding: 0.1rem 0.4rem;
      white-space: nowrap;
    }

    /* Description: two-line clamp */
    .beer-card-desc {
      font-size: 0.68rem;
      color: #3a3a3c;
      font-style: italic;
      line-height: 1.4;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }

    /* ---- Status states ---- */
    .status-message {
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
    }

    .status-icon { font-size: 3rem; opacity: 0.3; }

    .status-text {
      font-family: 'Oswald', sans-serif;
      font-size: 1.3rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #3a3a3a;
    }

    .status-sub { font-size: 0.75rem; color: #2e2e2e; letter-spacing: 0.05em; }

    /* ---- Footer ticker ---- */
    .tv-footer {
      flex-shrink: 0;
      margin-top: 0.6rem;
      padding-top: 0.5rem;
      border-top: 1px solid #1a1a1a;
      overflow: hidden;
    }

    .ticker-track {
      display: flex;
      white-space: nowrap;
      animation: ticker 35s linear infinite;
    }

    .ticker-track:hover { animation-play-state: paused; }

    .ticker-item {
      font-family: 'Oswald', sans-serif;
      font-size: 0.82rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: #303030;
      padding: 0 2.5rem;
    }

    .ticker-dot { color: #E13622; }

    @keyframes ticker {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }
  </style>
</head>
<body>
  <div class="tv-wrapper">
    <div class="tv-header">
      <div class="header-icon">&#x1F37A;</div>
      <div class="header-text">
        <h1><span class="brand">JTAPS</span> BEER MENU</h1>
        <div class="tagline">Bar &amp; Grill &nbsp;&middot;&nbsp; Cincinnati, OH</div>
      </div>
    </div>

    <div id="beer-tv-body" class="tv-body">
      <div class="status-message">
        <div class="status-icon">&#x1F37A;</div>
        <div class="status-text">Loading menu...</div>
      </div>
    </div>

    <div class="tv-footer">
      <div class="ticker-track">
        <span class="ticker-item">Ask your server about today&#x27;s specials</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Cold drafts &middot; Craft bottles &middot; Bar snacks</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Happy hour Mon&ndash;Fri 4&ndash;7 PM</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Watch every game right here at JTAPS</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Ask your server about today&#x27;s specials</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Cold drafts &middot; Craft bottles &middot; Bar snacks</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Happy hour Mon&ndash;Fri 4&ndash;7 PM</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Watch every game right here at JTAPS</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ SUPABASE_URL, SUPABASE_KEY }}>
    var tvBody = document.getElementById('beer-tv-body');

    function showStatus(icon, text, sub) {
      tvBody.innerHTML =
        '<div class="status-message">' +
        '<div class="status-icon">' + icon + '</div>' +
        '<div class="status-text">' + text + '</div>' +
        (sub ? '<div class="status-sub">' + sub + '</div>' : '') +
        '</div>';
    }

    function esc(str) {
      if (!str) return '';
      var d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    function renderCard(beer) {
      var featured = beer.featured ? 'is-featured' : '';
      var price = beer.price != null
        ? '<div class="beer-card-price">$' + Number(beer.price).toFixed(2) + '</div>'
        : '';
      var brewery = beer.brewery
        ? '<div class="beer-card-brewery">' + esc(beer.brewery) + '</div>'
        : '';
      var styleBadge = beer.style
        ? '<span class="style-badge">' + esc(beer.style) + '</span>'
        : '';
      var abvBadge = beer.abv != null
        ? '<span class="abv-badge">' + beer.abv + '% ABV</span>'
        : '';
      var badges = (styleBadge || abvBadge)
        ? '<div class="beer-card-badges">' + styleBadge + abvBadge + '</div>'
        : '';
      var desc = beer.description
        ? '<div class="beer-card-desc">' + esc(beer.description) + '</div>'
        : '';
      return (
        '<div class="beer-card ' + featured + '">' +
          '<div class="beer-card-header">' +
            '<div class="beer-card-name">' + esc(beer.name) + '</div>' +
            price +
          '</div>' +
          brewery +
          badges +
          desc +
        '</div>'
      );
    }

    async function fetchBeers() {
      if (!SUPABASE_URL || !SUPABASE_KEY || SUPABASE_URL === 'undefined') {
        showStatus('&#x26A0;', 'Supabase not configured', 'Check environment variables');
        return;
      }

      try {
        var url = SUPABASE_URL + '/rest/v1/beer_menu?select=*&available=eq.true&order=sort_order.asc,name.asc';
        var res = await fetch(url, {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': 'Bearer ' + SUPABASE_KEY,
            'Content-Type': 'application/json'
          }
        });

        if (!res.ok) {
          var errText = await res.text();
          showStatus('&#x26A0;', 'Error ' + res.status, errText.slice(0, 100));
          return;
        }

        var beers = await res.json();

        if (!beers || beers.length === 0) {
          showStatus('&#x1F37A;', 'No beers on tap right now', 'Check back soon!');
          return;
        }

        var servingOrder = ['Draft', 'Bottle', 'Can', 'Crowler', 'Growler'];
        var groups = {};
        beers.forEach(function(b) {
          var k = b.serving || 'Draft';
          if (!groups[k]) groups[k] = [];
          groups[k].push(b);
        });

        /*
          Flat render: section headings and cards are all siblings inside
          .beer-sections so they flow naturally through the CSS columns.
          column-span:all on the headings acts as a visual divider.
        */
        var parts = [];
        servingOrder
          .filter(function(k) { return groups[k] && groups[k].length > 0; })
          .forEach(function(k) {
            parts.push('<div class="section-heading">' + esc(k) + '</div>');
            groups[k].forEach(function(b) { parts.push(renderCard(b)); });
          });

        tvBody.innerHTML = '<div class="beer-sections">' + parts.join('') + '</div>';

        // Scale the grid down if it overflows the viewport height
        var sections = tvBody.querySelector('.beer-sections');
        if (sections) {
          var availH = tvBody.clientHeight;
          var contentH = sections.scrollHeight;
          if (contentH > availH) {
            var scale = availH / contentH;
            sections.style.transform = 'scale(' + scale.toFixed(4) + ')';
            sections.style.width = Math.ceil(100 / scale) + '%';
          }
        }
      } catch (err) {
        showStatus('&#x26A0;', 'Could not load menu', String(err).slice(0, 80));
      }
    }

    fetchBeers();
    setInterval(fetchBeers, 60000);
  </script>
</body>
</html>
