---
/**
 * Full-screen beer menu display designed for bar TVs.
 * Auto-refreshes every 60 seconds to pick up changes from admin.
 * No navigation or footer — this page is meant to run full-screen on a TV.
 */
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>JTAPS Beer Menu</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Open Sans', sans-serif;
      background: #111214;
      color: #f0ece4;
      height: 100vh;
      width: 100vw;
      overflow: hidden;
    }

    .tv-wrapper {
      height: 100vh;
      width: 100vw;
      display: flex;
      flex-direction: column;
      padding: 1.75rem 3rem 1.5rem;
    }

    /* ── Header (always visible) ────────────────── */
    .tv-header {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.5rem;
      margin-bottom: 1.25rem;
      padding-bottom: 1rem;
      border-bottom: 2px solid #2a2a2a;
      position: relative;
    }

    .tv-header::after {
      content: '';
      position: absolute;
      bottom: -5px;
      left: 10%;
      right: 10%;
      height: 2px;
      background: linear-gradient(90deg, transparent, #E13622 20%, #E13622 80%, transparent);
    }

    .header-logo {
      font-size: 3.2rem;
      line-height: 1;
      filter: drop-shadow(0 0 12px rgba(225,54,34,0.5));
    }

    .header-text { text-align: center; }

    .tv-header h1 {
      font-family: 'Oswald', sans-serif;
      font-size: 3.4rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      line-height: 1;
      color: #fff;
    }

    .tv-header h1 .brand { color: #E13622; }

    .tv-header .tagline {
      font-family: 'Oswald', sans-serif;
      font-size: 0.95rem;
      color: #888;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      margin-top: 0.3rem;
    }

    /* ── Beer list area ─────────────────────────── */
    .tv-body {
      flex: 1;
      display: flex;
      gap: 0;
      overflow: hidden;
      min-height: 0;
    }

    .tv-body .beer-column + .beer-column {
      border-left: 1px solid #2a2a2a;
      padding-left: 2.5rem;
      margin-left: 0.5rem;
    }

    .beer-column {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      padding-right: 2rem;
    }

    .section-title {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-family: 'Oswald', sans-serif;
      font-size: 1.1rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: #E13622;
      margin: 0.9rem 0 0.5rem;
      padding-bottom: 0.4rem;
      border-bottom: 1px solid #222;
    }
    .section-title:first-child { margin-top: 0; }

    .beer-item {
      display: flex;
      align-items: baseline;
      padding: 0.45rem 0;
      border-bottom: 1px solid rgba(255,255,255,0.04);
      position: relative;
    }
    .beer-item:last-child { border-bottom: none; }

    .beer-item.is-featured { padding-left: 0.75rem; }
    .beer-item.is-featured::before {
      content: '';
      position: absolute;
      left: 0; top: 0.3rem; bottom: 0.3rem;
      width: 3px;
      background: #FFD700;
      border-radius: 2px;
    }

    .beer-info { flex: 1; min-width: 0; }

    .beer-name-row {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .beer-name {
      font-family: 'Oswald', sans-serif;
      font-size: 1.2rem;
      font-weight: 500;
      color: #f0ece4;
    }
    .beer-item.is-featured .beer-name { color: #fff; }

    .abv-badge {
      font-family: 'Oswald', sans-serif;
      font-size: 0.7rem;
      font-weight: 600;
      color: #888;
      background: rgba(255,255,255,0.06);
      border: 1px solid #333;
      border-radius: 3px;
      padding: 0 0.35rem;
      white-space: nowrap;
      flex-shrink: 0;
      letter-spacing: 0.05em;
    }

    .style-badge {
      font-family: 'Oswald', sans-serif;
      font-size: 0.65rem;
      font-weight: 400;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #E13622;
      background: rgba(225,54,34,0.1);
      border: 1px solid rgba(225,54,34,0.25);
      border-radius: 3px;
      padding: 0 0.4rem;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .beer-brewery {
      font-size: 0.75rem;
      color: #666;
      margin-top: 0.1rem;
    }

    .beer-description {
      font-size: 0.72rem;
      color: #555;
      margin-top: 0.05rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-style: italic;
    }

    .beer-leader {
      flex: 1;
      min-width: 1rem;
      border-bottom: 2px dotted #2d2d2d;
      margin: 0 0.5rem 0.3rem;
    }

    .beer-price {
      font-family: 'Oswald', sans-serif;
      font-size: 1.3rem;
      font-weight: 600;
      color: #f0ece4;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .beer-item.is-featured .beer-price { color: #FFD700; }

    /* ── Status states ──────────────────────────── */
    .status-message {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      color: #888;
    }

    .status-message .status-icon {
      font-size: 3rem;
      opacity: 0.5;
    }

    .status-message .status-text {
      font-family: 'Oswald', sans-serif;
      font-size: 1.4rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #666;
    }

    .status-message .status-sub {
      font-size: 0.85rem;
      color: #444;
      letter-spacing: 0.05em;
    }

    /* ── Footer ticker ──────────────────────────── */
    .tv-footer {
      flex-shrink: 0;
      margin-top: 1rem;
      padding-top: 0.75rem;
      border-top: 1px solid #222;
      overflow: hidden;
    }

    .ticker-track {
      display: flex;
      white-space: nowrap;
      animation: ticker 30s linear infinite;
    }
    .ticker-track:hover { animation-play-state: paused; }

    .ticker-item {
      font-family: 'Oswald', sans-serif;
      font-size: 1rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: #555;
      padding: 0 3rem;
    }
    .ticker-dot { color: #E13622; margin: 0 0.75rem; }

    @keyframes ticker {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }
  </style>
</head>
<body>
  <!-- Header is static HTML — always visible regardless of JS -->
  <div class="tv-wrapper">
    <div class="tv-header">
      <span class="header-logo">🍺</span>
      <div class="header-text">
        <h1><span class="brand">JTAPS</span> BEER MENU</h1>
        <div class="tagline">Bar &amp; Grill &nbsp;·&nbsp; Cincinnati, OH</div>
      </div>
    </div>

    <!-- JS fills this section only -->
    <div id="beer-tv-body" class="tv-body">
      <div class="status-message">
        <span class="status-icon">🍺</span>
        <span class="status-text">Loading menu...</span>
      </div>
    </div>

    <div class="tv-footer">
      <div class="ticker-track" id="beer-ticker">
        <span class="ticker-item">Ask your server about today's specials</span>
        <span class="ticker-item"><span class="ticker-dot">✦</span></span>
        <span class="ticker-item">Cold drafts · Craft bottles · Bar snacks</span>
        <span class="ticker-item"><span class="ticker-dot">✦</span></span>
        <span class="ticker-item">Happy hour Mon–Fri 4–7 PM</span>
        <span class="ticker-item"><span class="ticker-dot">✦</span></span>
        <span class="ticker-item">Watch every game right here at JTAPS</span>
        <span class="ticker-item"><span class="ticker-dot">✦</span></span>
        <span class="ticker-item">Ask your server about today's specials</span>
        <span class="ticker-item"><span class="ticker-dot">✦</span></span>
        <span class="ticker-item">Cold drafts · Craft bottles · Bar snacks</span>
        <span class="ticker-item"><span class="ticker-dot">✦</span></span>
        <span class="ticker-item">Happy hour Mon–Fri 4–7 PM</span>
        <span class="ticker-item"><span class="ticker-dot">✦</span></span>
        <span class="ticker-item">Watch every game right here at JTAPS</span>
        <span class="ticker-item"><span class="ticker-dot">✦</span></span>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ SUPABASE_URL, SUPABASE_KEY }}>
    const body = document.getElementById('beer-tv-body');

    function showStatus(icon, text, sub) {
      body.innerHTML = `
        <div class="status-message">
          <span class="status-icon">${icon}</span>
          <span class="status-text">${text}</span>
          ${sub ? `<span class="status-sub">${sub}</span>` : ''}
        </div>`;
    }

    function esc(str) {
      if (!str) return '';
      const d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    function renderBeerRow(beer) {
      const featured = beer.featured ? 'is-featured' : '';
      const abvBadge = beer.abv != null ? `<span class="abv-badge">${beer.abv}% ABV</span>` : '';
      const styleBadge = beer.style ? `<span class="style-badge">${esc(beer.style)}</span>` : '';
      const price = beer.price != null
        ? `<span class="beer-leader"></span><span class="beer-price">$${Number(beer.price).toFixed(2)}</span>` : '';
      const brewery = beer.brewery ? `<div class="beer-brewery">${esc(beer.brewery)}</div>` : '';
      const desc = beer.description ? `<div class="beer-description">${esc(beer.description)}</div>` : '';

      return `
        <div class="beer-item ${featured}">
          <div class="beer-info">
            <div class="beer-name-row">
              <span class="beer-name">${esc(beer.name)}</span>
              ${styleBadge}${abvBadge}
            </div>
            ${brewery}${desc}
          </div>
          ${price}
        </div>`;
    }

    function renderColumn(sections) {
      return sections.map(s => `
        <div class="section-title">🍺 ${esc(s.title)}</div>
        <div class="beer-list">${s.items.map(renderBeerRow).join('')}</div>
      `).join('');
    }

    async function fetchBeers() {
      if (!SUPABASE_URL || !SUPABASE_KEY || SUPABASE_URL === 'undefined') {
        showStatus('⚠️', 'Supabase not configured', 'Check environment variables');
        return;
      }

      try {
        // Fetch all available beers — no complex filter to avoid empty results
        const url = `${SUPABASE_URL}/rest/v1/beer_menu?select=*&available=eq.true&order=sort_order.asc,name.asc`;
        const res = await fetch(url, {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`,
            'Content-Type': 'application/json'
          }
        });

        if (!res.ok) {
          const errText = await res.text();
          showStatus('⚠️', `Error ${res.status}`, errText.slice(0, 100));
          return;
        }

        const beers = await res.json();

        if (!beers || beers.length === 0) {
          showStatus('🍺', 'No beers on tap right now', 'Check back soon!');
          return;
        }

        // Group by serving type
        const servingOrder = ['Draft', 'Bottle', 'Can', 'Crowler', 'Growler'];
        const groups = {};
        beers.forEach(b => {
          const k = b.serving || 'Draft';
          if (!groups[k]) groups[k] = [];
          groups[k].push(b);
        });
        const allSections = servingOrder
          .filter(k => groups[k] && groups[k].length > 0)
          .map(k => ({ title: k, items: groups[k] }));

        // Balance two columns
        const total = beers.length;
        let left = 0, splitIdx = allSections.length;
        for (let i = 0; i < allSections.length; i++) {
          left += allSections[i].items.length;
          if (left >= total / 2) { splitIdx = i + 1; break; }
        }
        const leftSections  = allSections.slice(0, splitIdx);
        const rightSections = allSections.slice(splitIdx);

        body.innerHTML = `
          <div class="beer-column">${renderColumn(leftSections)}</div>
          ${rightSections.length > 0 ? `<div class="beer-column">${renderColumn(rightSections)}</div>` : ''}
        `;
      } catch (err) {
        showStatus('⚠️', 'Could not load menu', String(err).slice(0, 80));
      }
    }

    fetchBeers();
    setInterval(fetchBeers, 60000);
  </script>
</body>
</html>

