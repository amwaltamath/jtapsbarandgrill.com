---
/**
 * Full-screen beer menu display designed for bar TVs.
 * Auto-refreshes every 60 seconds to pick up changes from admin.
 * No navigation or footer — this page is meant to run full-screen on a TV.
 */
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>JTAPS Beer Menu</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Open Sans', sans-serif;
      background: #0d0d0d;
      color: #f5f5f5;
      overflow: hidden;
      height: 100vh;
      width: 100vw;
    }

    .tv-container {
      height: 100vh;
      width: 100vw;
      display: flex;
      flex-direction: column;
      padding: 2rem 3rem;
    }

    /* Header */
    .tv-header {
      text-align: center;
      flex-shrink: 0;
      margin-bottom: 1.5rem;
      border-bottom: 3px solid #E13622;
      padding-bottom: 1rem;
    }

    .tv-header h1 {
      font-family: 'Oswald', sans-serif;
      font-size: 3.5rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #fff;
    }

    .tv-header h1 span {
      color: #E13622;
    }

    .tv-header .tagline {
      font-size: 1.1rem;
      color: #aaa;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-top: 0.25rem;
    }

    /* Beer Sections Grid */
    .tv-body {
      flex: 1;
      display: flex;
      gap: 2rem;
      overflow: hidden;
    }

    .beer-column {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .section-title {
      font-family: 'Oswald', sans-serif;
      font-size: 1.6rem;
      font-weight: 600;
      text-transform: uppercase;
      color: #E13622;
      letter-spacing: 0.08em;
      margin-bottom: 0.75rem;
      border-bottom: 1px solid #333;
      padding-bottom: 0.4rem;
    }

    .beer-list {
      flex: 1;
      overflow: hidden;
    }

    .beer-item {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 0.5rem 0;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .beer-item:last-child {
      border-bottom: none;
    }

    .beer-info {
      flex: 1;
      min-width: 0;
    }

    .beer-name {
      font-family: 'Oswald', sans-serif;
      font-size: 1.25rem;
      font-weight: 500;
      color: #fff;
    }

    .beer-name .featured-star {
      color: #FFD700;
      margin-left: 0.4rem;
    }

    .beer-meta {
      font-size: 0.8rem;
      color: #999;
      margin-top: 0.1rem;
    }

    .beer-meta span + span::before {
      content: ' · ';
      color: #555;
    }

    .beer-price {
      font-family: 'Oswald', sans-serif;
      font-size: 1.3rem;
      font-weight: 600;
      color: #E13622;
      white-space: nowrap;
      margin-left: 1rem;
    }

    .beer-description {
      font-size: 0.75rem;
      color: #777;
      margin-top: 0.15rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Footer */
    .tv-footer {
      flex-shrink: 0;
      text-align: center;
      padding-top: 1rem;
      margin-top: 1rem;
      border-top: 2px solid #222;
      color: #555;
      font-size: 0.85rem;
    }

    .tv-footer .promo {
      color: #E13622;
      font-family: 'Oswald', sans-serif;
      font-size: 1.2rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    /* Loading state */
    .loading {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100vh;
      font-family: 'Oswald', sans-serif;
      font-size: 2rem;
      color: #E13622;
    }

    /* Empty state */
    .empty-state {
      text-align: center;
      color: #666;
      padding: 4rem;
      font-size: 1.3rem;
    }
  </style>
</head>
<body>
  <div id="beer-tv-root">
    <div class="loading">🍺 Loading Beer Menu...</div>
  </div>

  <script is:inline define:vars={{ SUPABASE_URL, SUPABASE_KEY }}>
    const REFRESH_INTERVAL = 60000; // 60 seconds

    async function fetchBeers() {
      if (!SUPABASE_URL || !SUPABASE_KEY) {
        document.getElementById('beer-tv-root').innerHTML =
          '<div class="loading">⚠️ Supabase not configured</div>';
        return;
      }

      try {
        const url = `${SUPABASE_URL}/rest/v1/beer_menu?available=eq.true&order=sort_order.asc,style.asc&select=*`;
        const res = await fetch(url, {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`
          }
        });

        if (!res.ok) throw new Error('Failed to fetch');
        const beers = await res.json();
        renderMenu(beers);
      } catch (err) {
        console.error('Beer menu fetch error:', err);
      }
    }

    function renderMenu(beers) {
      const root = document.getElementById('beer-tv-root');

      if (!beers || beers.length === 0) {
        root.innerHTML = `
          <div class="tv-container">
            <div class="tv-header">
              <h1>🍺 <span>JTAPS</span> BEER MENU</h1>
            </div>
            <div class="empty-state">Beer menu coming soon!</div>
          </div>`;
        return;
      }

      // Group by serving type
      const groups = {};
      beers.forEach(beer => {
        const key = beer.serving || 'Draft';
        if (!groups[key]) groups[key] = [];
        groups[key].push(beer);
      });

      const servingOrder = ['Draft', 'Bottle', 'Can', 'Crowler', 'Growler'];
      const orderedKeys = servingOrder.filter(k => groups[k] && groups[k].length > 0);

      // Split into two columns for TV layout
      let allSections = [];
      orderedKeys.forEach(key => {
        allSections.push({ title: key, items: groups[key] });
      });

      // Balance columns by item count
      const totalItems = beers.length;
      let leftCount = 0;
      let splitIdx = allSections.length;
      for (let i = 0; i < allSections.length; i++) {
        leftCount += allSections[i].items.length;
        if (leftCount >= totalItems / 2) {
          splitIdx = i + 1;
          break;
        }
      }

      const leftSections = allSections.slice(0, splitIdx);
      const rightSections = allSections.slice(splitIdx);

      function renderColumn(sections) {
        return sections.map(section => `
          <div class="section-title">🍺 ${escapeHtml(section.title)}</div>
          <div class="beer-list">
            ${section.items.map(beer => `
              <div class="beer-item">
                <div class="beer-info">
                  <div class="beer-name">
                    ${escapeHtml(beer.name)}${beer.featured ? '<span class="featured-star">★</span>' : ''}
                  </div>
                  <div class="beer-meta">
                    ${beer.brewery ? `<span>${escapeHtml(beer.brewery)}</span>` : ''}
                    <span>${escapeHtml(beer.style)}</span>
                    ${beer.abv != null ? `<span>${beer.abv}% ABV</span>` : ''}
                    ${beer.ibu != null ? `<span>${beer.ibu} IBU</span>` : ''}
                  </div>
                  ${beer.description ? `<div class="beer-description">${escapeHtml(beer.description)}</div>` : ''}
                </div>
                <div class="beer-price">$${Number(beer.price).toFixed(2)}</div>
              </div>
            `).join('')}
          </div>
        `).join('');
      }

      root.innerHTML = `
        <div class="tv-container">
          <div class="tv-header">
            <h1>🍺 <span>JTAPS</span> BEER MENU</h1>
            <div class="tagline">Bar & Grill · Cold Beers · Good Times</div>
          </div>
          <div class="tv-body">
            <div class="beer-column">${renderColumn(leftSections)}</div>
            ${rightSections.length > 0 ? `<div class="beer-column">${renderColumn(rightSections)}</div>` : ''}
          </div>
          <div class="tv-footer">
            <div class="promo">Ask your server about today's specials!</div>
          </div>
        </div>`;
    }

    function escapeHtml(str) {
      if (!str) return '';
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    // Initial load
    fetchBeers();

    // Auto-refresh
    setInterval(fetchBeers, REFRESH_INTERVAL);
  </script>
</body>
</html>
