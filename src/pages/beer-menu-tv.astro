---
/**
 * Full-screen beer menu display designed for bar TVs.
 * Auto-refreshes every 60 seconds.
 */
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>JTAPS Beer Menu</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Open Sans', sans-serif;
      background: #111214;
      color: #f0ece4;
      height: 100vh;
      width: 100vw;
      overflow: hidden;
    }

    .tv-wrapper {
      height: 100vh;
      width: 100vw;
      display: flex;
      flex-direction: column;
      padding: 1.5rem 2.5rem 1rem;
    }

    /* ---- Header ---- */
    .tv-header {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.5rem;
      margin-bottom: 1.1rem;
      padding-bottom: 1rem;
      border-bottom: 2px solid #2a2a2a;
      position: relative;
    }

    .tv-header::after {
      content: '';
      position: absolute;
      bottom: -5px;
      left: 10%;
      right: 10%;
      height: 2px;
      background: linear-gradient(90deg, transparent, #E13622 20%, #E13622 80%, transparent);
    }

    .header-icon { font-size: 2.8rem; line-height: 1; }

    .header-text { text-align: center; }

    .tv-header h1 {
      font-family: 'Oswald', sans-serif;
      font-size: 3rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      line-height: 1;
      color: #fff;
    }

    .tv-header h1 .brand { color: #E13622; }

    .tv-header .tagline {
      font-family: 'Oswald', sans-serif;
      font-size: 0.85rem;
      color: #555;
      letter-spacing: 0.35em;
      text-transform: uppercase;
      margin-top: 0.3rem;
    }

    /* ---- Body ---- */
    .tv-body {
      flex: 1;
      min-height: 0;
      overflow: hidden;
    }

    /* Beer table layout — universally supported */
    .beer-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 8px;
      table-layout: fixed;
    }

    .beer-table td {
      width: 25%;
      vertical-align: top;
      background: #1b1c1e;
      border: 1px solid #2a2a2c;
      border-left: 4px solid #E13622;
      border-radius: 6px;
      padding: 12px 14px;
    }

    .beer-table td.is-featured {
      border-color: #FFD700;
      border-left: 4px solid #FFD700;
      background: #1e1d14;
    }

    .beer-table td.empty-cell {
      background: transparent;
      border: none;
    }

    /* Section heading row */
    .section-heading-cell {
      background: transparent !important;
      border: none !important;
      border-left: none !important;
      padding: 10px 4px 4px !important;
      font-family: 'Oswald', sans-serif;
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #999;
    }

    .section-heading-cell .heading-inner {
      display: table;
      width: 100%;
    }

    .section-heading-cell .heading-inner .accent {
      display: table-cell;
      width: 24px;
      vertical-align: middle;
    }

    .section-heading-cell .heading-inner .accent-bar {
      display: block;
      width: 24px;
      height: 3px;
      background: #E13622;
    }

    .section-heading-cell .heading-inner .label {
      display: table-cell;
      padding: 0 8px;
      white-space: nowrap;
      color: #999;
    }

    .section-heading-cell .heading-inner .line {
      display: table-cell;
      width: 99%;
      vertical-align: middle;
    }

    .section-heading-cell .heading-inner .line-bar {
      display: block;
      height: 1px;
      background: #2a2a2c;
    }

    .beer-name {
      font-family: 'Oswald', sans-serif;
      font-size: 1.05rem;
      font-weight: 700;
      color: #f0ece4;
      line-height: 1.2;
    }

    td.is-featured .beer-name { color: #fff; }

    .beer-price {
      font-family: 'Oswald', sans-serif;
      font-size: 1.05rem;
      font-weight: 700;
      color: #E13622;
      float: right;
      margin-left: 8px;
      white-space: nowrap;
    }

    td.is-featured .beer-price { color: #FFD700; }

    .beer-brewery {
      font-size: 0.7rem;
      color: #777;
      margin-top: 2px;
    }

    .beer-meta {
      margin-top: 4px;
    }

    .beer-style {
      font-size: 0.6rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #E13622;
      background: rgba(225,54,34,0.08);
      border: 1px solid rgba(225,54,34,0.18);
      border-radius: 3px;
      padding: 1px 5px;
      display: inline-block;
    }

    .beer-abv {
      font-size: 0.6rem;
      font-weight: 600;
      color: #888;
      background: rgba(255,255,255,0.04);
      border: 1px solid #333;
      border-radius: 3px;
      padding: 1px 5px;
      margin-left: 3px;
      display: inline-block;
    }

    .beer-desc {
      font-size: 0.65rem;
      color: #3a3a3c;
      font-style: italic;
      line-height: 1.35;
      margin-top: 3px;
    }

    /* ---- Status states ---- */
    .status-message {
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
    }

    .status-icon { font-size: 3rem; opacity: 0.3; }

    .status-text {
      font-family: 'Oswald', sans-serif;
      font-size: 1.3rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #3a3a3a;
    }

    .status-sub { font-size: 0.75rem; color: #2e2e2e; letter-spacing: 0.05em; }

    /* ---- Footer ticker ---- */
    .tv-footer {
      flex-shrink: 0;
      margin-top: 0.6rem;
      padding-top: 0.5rem;
      border-top: 1px solid #1a1a1a;
      overflow: hidden;
    }

    .ticker-track {
      display: flex;
      white-space: nowrap;
      animation: ticker 35s linear infinite;
    }

    .ticker-track:hover { animation-play-state: paused; }

    .ticker-item {
      font-family: 'Oswald', sans-serif;
      font-size: 0.82rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: #303030;
      padding: 0 2.5rem;
    }

    .ticker-dot { color: #E13622; }

    @keyframes ticker {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }
  </style>
</head>
<body>
  <div class="tv-wrapper">
    <div class="tv-header">
      <div class="header-icon">&#x1F37A;</div>
      <div class="header-text">
        <h1><span class="brand">JTAPS</span> BEER MENU</h1>
        <div class="tagline">Bar &amp; Grill &nbsp;&middot;&nbsp; Cincinnati, OH</div>
      </div>
    </div>

    <div id="beer-tv-body" class="tv-body">
      <div class="status-message">
        <div class="status-icon">&#x1F37A;</div>
        <div class="status-text">Loading menu...</div>
      </div>
    </div>

    <div class="tv-footer">
      <div class="ticker-track">
        <span class="ticker-item">Ask your server about today&#x27;s specials</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Cold drafts &middot; Craft bottles &middot; Bar snacks</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Happy hour Mon&ndash;Fri 4&ndash;7 PM</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Watch every game right here at JTAPS</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Ask your server about today&#x27;s specials</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Cold drafts &middot; Craft bottles &middot; Bar snacks</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Happy hour Mon&ndash;Fri 4&ndash;7 PM</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Watch every game right here at JTAPS</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ SUPABASE_URL, SUPABASE_KEY }}>
    var tvBody = document.getElementById('beer-tv-body');

    function showStatus(icon, text, sub) {
      tvBody.innerHTML =
        '<div class="status-message">' +
        '<div class="status-icon">' + icon + '</div>' +
        '<div class="status-text">' + text + '</div>' +
        (sub ? '<div class="status-sub">' + sub + '</div>' : '') +
        '</div>';
    }

    function esc(str) {
      if (!str) return '';
      var d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    function renderCell(beer) {
      var cls = beer.featured ? 'is-featured' : '';
      var price = beer.price != null
        ? '<span class="beer-price">$' + Number(beer.price).toFixed(2) + '</span>'
        : '';
      var brewery = beer.brewery
        ? '<div class="beer-brewery">' + esc(beer.brewery) + '</div>'
        : '';
      var style = beer.style
        ? '<span class="beer-style">' + esc(beer.style) + '</span>'
        : '';
      var abv = beer.abv != null
        ? '<span class="beer-abv">' + beer.abv + '% ABV</span>'
        : '';
      var meta = (style || abv)
        ? '<div class="beer-meta">' + style + abv + '</div>'
        : '';
      var desc = beer.description
        ? '<div class="beer-desc">' + esc(beer.description) + '</div>'
        : '';
      return '<td class="' + cls + '">' + price +
        '<div class="beer-name">' + esc(beer.name) + '</div>' +
        brewery + meta + desc + '</td>';
    }

    async function fetchBeers() {
      if (!SUPABASE_URL || !SUPABASE_KEY || SUPABASE_URL === 'undefined') {
        showStatus('&#x26A0;', 'Supabase not configured', 'Check environment variables');
        return;
      }

      try {
        var url = SUPABASE_URL + '/rest/v1/beer_menu?select=*&available=eq.true&order=sort_order.asc,name.asc';
        var res = await fetch(url, {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': 'Bearer ' + SUPABASE_KEY,
            'Content-Type': 'application/json'
          }
        });

        if (!res.ok) {
          var errText = await res.text();
          showStatus('&#x26A0;', 'Error ' + res.status, errText.slice(0, 100));
          return;
        }

        var beers = await res.json();

        if (!beers || beers.length === 0) {
          showStatus('&#x1F37A;', 'No beers on tap right now', 'Check back soon!');
          return;
        }

        var COLS = 4;
        var servingOrder = ['Draft', 'Bottle', 'Can', 'Crowler', 'Growler'];
        var groups = {};
        beers.forEach(function(b) {
          var k = b.serving || 'Draft';
          if (!groups[k]) groups[k] = [];
          groups[k].push(b);
        });

        // Build an HTML table: 4 beer tiles per row
        var html = '<table class="beer-table">';
        servingOrder
          .filter(function(k) { return groups[k] && groups[k].length > 0; })
          .forEach(function(k) {
            // Section heading row spanning all columns
            html += '<tr><td colspan="' + COLS + '" class="section-heading-cell">' +
              '<div class="heading-inner">' +
                '<div class="accent"><span class="accent-bar"></span></div>' +
                '<div class="label">' + esc(k) + '</div>' +
                '<div class="line"><span class="line-bar"></span></div>' +
              '</div>' +
            '</td></tr>';
            // Beer cells in rows of COLS
            var items = groups[k];
            for (var i = 0; i < items.length; i += COLS) {
              html += '<tr>';
              for (var j = 0; j < COLS; j++) {
                if (i + j < items.length) {
                  html += renderCell(items[i + j]);
                } else {
                  html += '<td class="empty-cell"></td>';
                }
              }
              html += '</tr>';
            }
          });
        html += '</table>';
        tvBody.innerHTML = html;
      } catch (err) {
        showStatus('&#x26A0;', 'Could not load menu', String(err).slice(0, 80));
      }
    }

    fetchBeers();
    setInterval(fetchBeers, 60000);
  </script>
</body>
</html>
