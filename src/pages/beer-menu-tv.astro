---
/**
 * Full-screen beer menu display designed for bar TVs.
 * Auto-refreshes every 60 seconds with smooth crossfade.
 */
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>JTAPS Beer Menu</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', sans-serif;
      background: #0a0a0c;
      color: #e8e4dc;
      height: 100vh;
      width: 100vw;
      overflow: hidden;
    }

    /* Subtle background texture */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse at 20% 50%, rgba(225,54,34,0.04) 0%, transparent 60%),
        radial-gradient(ellipse at 80% 50%, rgba(225,54,34,0.03) 0%, transparent 60%);
      pointer-events: none;
      z-index: 0;
    }

    .tv-wrapper {
      position: relative;
      z-index: 1;
      height: 100vh;
      width: 100vw;
      display: flex;
      flex-direction: column;
      padding: 1rem 1.5rem 0.6rem;
    }

    /* ---- Header ---- */
    .tv-header {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.2rem;
      margin-bottom: 0.8rem;
      padding-bottom: 0.8rem;
      position: relative;
    }

    .tv-header::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 5%;
      right: 5%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(225,54,34,0.5) 30%, rgba(225,54,34,0.5) 70%, transparent);
    }

    .header-logo {
      width: 48px;
      height: 48px;
      background: linear-gradient(135deg, #E13622, #c42810);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      line-height: 1;
      box-shadow: 0 4px 20px rgba(225,54,34,0.3);
    }

    .header-text { text-align: center; }

    .tv-header h1 {
      font-family: 'Oswald', sans-serif;
      font-size: 2rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      line-height: 1;
      color: #fff;
    }

    .tv-header h1 .brand { color: #E13622; }

    .tv-header .tagline {
      font-family: 'Inter', sans-serif;
      font-size: 0.7rem;
      color: #555;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      margin-top: 0.25rem;
      font-weight: 500;
    }

    .header-live {
      position: absolute;
      right: 1.5rem;
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-family: 'Inter', sans-serif;
      font-size: 0.65rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: #444;
    }

    .live-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #22c55e;
      animation: pulse-dot 2s ease-in-out infinite;
    }

    @keyframes pulse-dot {
      0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(34,197,94,0.4); }
      50% { opacity: 0.7; box-shadow: 0 0 0 4px rgba(34,197,94,0); }
    }

    /* ---- Body ---- */
    .tv-body {
      flex: 1;
      min-height: 0;
      overflow: hidden;
      transition: opacity 0.4s ease;
    }

    /* ---- Section Layout ---- */
    .menu-sections {
      height: 100%;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }

    .menu-section {
      animation: fadeSlideIn 0.5s ease both;
    }

    .section-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.5rem;
    }

    .section-icon {
      font-size: 1rem;
      width: 28px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(225,54,34,0.1);
      border: 1px solid rgba(225,54,34,0.2);
      border-radius: 6px;
    }

    .section-title {
      font-family: 'Oswald', sans-serif;
      font-size: 0.9rem;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #888;
    }

    .section-count {
      font-family: 'Inter', sans-serif;
      font-size: 0.65rem;
      font-weight: 600;
      color: #555;
      background: rgba(255,255,255,0.04);
      border: 1px solid #2a2a2d;
      border-radius: 10px;
      padding: 2px 8px;
    }

    .section-line {
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, #2a2a2d, transparent);
    }

    /* ---- Beer Grid ---- */
    .beer-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
    }

    /* ---- Beer Card ---- */
    .beer-card {
      background: linear-gradient(145deg, rgba(28,29,33,0.9), rgba(20,21,24,0.95));
      border: 1px solid #2a2a2d;
      border-radius: 10px;
      padding: 12px 14px;
      position: relative;
      overflow: hidden;
      transition: transform 0.2s ease, border-color 0.2s ease;
      animation: fadeIn 0.4s ease both;
    }

    .beer-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, #E13622, rgba(225,54,34,0.3));
      opacity: 0.6;
    }

    .beer-card.is-featured {
      border-color: rgba(255,215,0,0.3);
      background: linear-gradient(145deg, rgba(34,33,20,0.95), rgba(25,24,14,0.95));
    }

    .beer-card.is-featured::before {
      background: linear-gradient(90deg, #FFD700, rgba(255,215,0,0.3));
      opacity: 0.8;
    }

    .beer-card.is-featured::after {
      content: '★';
      position: absolute;
      top: 8px;
      right: 10px;
      font-size: 0.65rem;
      color: #FFD700;
      opacity: 0.7;
    }

    /* Card content */
    .card-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 8px;
    }

    .beer-name {
      font-family: 'Oswald', sans-serif;
      font-size: 1.05rem;
      font-weight: 600;
      color: #fff;
      line-height: 1.2;
      flex: 1;
    }

    .beer-price {
      font-family: 'Oswald', sans-serif;
      font-size: 1.05rem;
      font-weight: 700;
      color: #E13622;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .beer-card.is-featured .beer-price {
      color: #FFD700;
    }

    .beer-brewery {
      font-size: 0.72rem;
      color: #777;
      margin-top: 2px;
      font-weight: 500;
    }

    .beer-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin-top: 6px;
    }

    .beer-style {
      font-size: 0.6rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #E13622;
      background: rgba(225,54,34,0.08);
      border: 1px solid rgba(225,54,34,0.2);
      border-radius: 4px;
      padding: 2px 6px;
    }

    .beer-card.is-featured .beer-style {
      color: #FFD700;
      background: rgba(255,215,0,0.08);
      border-color: rgba(255,215,0,0.2);
    }

    .beer-abv {
      font-size: 0.6rem;
      font-weight: 600;
      color: #999;
      background: rgba(255,255,255,0.04);
      border: 1px solid #333;
      border-radius: 4px;
      padding: 2px 6px;
    }

    .beer-ibu {
      font-size: 0.6rem;
      font-weight: 600;
      color: #777;
      background: rgba(255,255,255,0.03);
      border: 1px solid #2a2a2d;
      border-radius: 4px;
      padding: 2px 6px;
    }

    .beer-desc {
      font-size: 0.68rem;
      color: #666;
      line-height: 1.35;
      margin-top: 5px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* ---- Status states ---- */
    .status-message {
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1rem;
    }

    .status-icon {
      font-size: 3rem;
      opacity: 0.2;
      animation: float 3s ease-in-out infinite;
    }

    .status-text {
      font-family: 'Oswald', sans-serif;
      font-size: 1.2rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #333;
    }

    .status-sub {
      font-size: 0.72rem;
      color: #2a2a2a;
      letter-spacing: 0.05em;
    }

    .loading-bar {
      width: 120px;
      height: 2px;
      background: #1a1a1d;
      border-radius: 2px;
      overflow: hidden;
    }

    .loading-bar::after {
      content: '';
      display: block;
      width: 40%;
      height: 100%;
      background: #E13622;
      border-radius: 2px;
      animation: loadSlide 1.2s ease-in-out infinite;
    }

    @keyframes loadSlide {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(350%); }
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-6px); }
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes fadeSlideIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ---- Footer ticker ---- */
    .tv-footer {
      flex-shrink: 0;
      margin-top: 0.5rem;
      padding-top: 0.5rem;
      border-top: 1px solid #1a1a1d;
      overflow: hidden;
    }

    .ticker-track {
      display: flex;
      white-space: nowrap;
      animation: ticker 40s linear infinite;
    }

    .ticker-item {
      font-family: 'Inter', sans-serif;
      font-size: 0.7rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: #333;
      padding: 0 2rem;
    }

    .ticker-dot { color: #E13622; font-size: 0.5rem; }

    @keyframes ticker {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }
  </style>
</head>
<body>
  <div class="tv-wrapper">
    <div class="tv-header">
      <div class="header-logo">&#x1F37A;</div>
      <div class="header-text">
        <h1><span class="brand">JTAPS</span> BEER MENU</h1>
        <div class="tagline">Bar &amp; Grill &nbsp;&bull;&nbsp; Cincinnati, OH</div>
      </div>
      <div class="header-live">
        <span class="live-dot"></span>
        Live
      </div>
    </div>

    <div id="beer-tv-body" class="tv-body">
      <div class="status-message">
        <div class="status-icon">&#x1F37A;</div>
        <div class="status-text">Loading menu&hellip;</div>
        <div class="loading-bar"></div>
      </div>
    </div>

    <div class="tv-footer">
      <div class="ticker-track">
        <span class="ticker-item">Ask your server about today&#x27;s specials</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Cold drafts &middot; Craft bottles &middot; Bar snacks</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Happy hour Mon&ndash;Fri 4&ndash;7 PM</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Watch every game right here at JTAPS</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Ask your server about today&#x27;s specials</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Cold drafts &middot; Craft bottles &middot; Bar snacks</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Happy hour Mon&ndash;Fri 4&ndash;7 PM</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Watch every game right here at JTAPS</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ SUPABASE_URL, SUPABASE_KEY }}>
    var tvBody = document.getElementById('beer-tv-body');
    var isFirstLoad = true;

    var servingIcons = {
      'Draft': '🍺',
      'Bottle': '🍾',
      'Can': '🥫',
      'Crowler': '🫙',
      'Growler': '🍻'
    };

    function showStatus(icon, text, sub) {
      tvBody.innerHTML =
        '<div class="status-message">' +
          '<div class="status-icon">' + icon + '</div>' +
          '<div class="status-text">' + text + '</div>' +
          (sub ? '<div class="status-sub">' + sub + '</div>' : '') +
        '</div>';
    }

    function esc(str) {
      if (!str) return '';
      var d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    function renderCard(beer, index) {
      var cls = 'beer-card' + (beer.featured ? ' is-featured' : '');
      var delay = isFirstLoad ? ' style="animation-delay:' + (index * 0.04) + 's"' : '';

      var price = beer.price != null
        ? '<span class="beer-price">$' + Number(beer.price).toFixed(2) + '</span>'
        : '';

      var brewery = beer.brewery
        ? '<div class="beer-brewery">' + esc(beer.brewery) + '</div>'
        : '';

      var tags = '';
      if (beer.style || beer.abv != null || beer.ibu != null) {
        tags = '<div class="beer-tags">';
        if (beer.style) tags += '<span class="beer-style">' + esc(beer.style) + '</span>';
        if (beer.abv != null) tags += '<span class="beer-abv">' + beer.abv + '% ABV</span>';
        if (beer.ibu != null) tags += '<span class="beer-ibu">' + beer.ibu + ' IBU</span>';
        tags += '</div>';
      }

      var desc = beer.description
        ? '<div class="beer-desc">' + esc(beer.description) + '</div>'
        : '';

      return '<div class="' + cls + '"' + delay + '>' +
        '<div class="card-top">' +
          '<div class="beer-name">' + esc(beer.name) + '</div>' +
          price +
        '</div>' +
        brewery + tags + desc +
      '</div>';
    }

    async function fetchBeers() {
      if (!SUPABASE_URL || !SUPABASE_KEY || SUPABASE_URL === 'undefined') {
        showStatus('&#x26A0;', 'Supabase not configured', 'Check environment variables');
        return;
      }

      try {
        var url = SUPABASE_URL + '/rest/v1/beer_menu?select=*&available=eq.true&order=sort_order.asc,name.asc';
        var res = await fetch(url, {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': 'Bearer ' + SUPABASE_KEY,
            'Content-Type': 'application/json'
          }
        });

        if (!res.ok) {
          var errText = await res.text();
          showStatus('&#x26A0;', 'Error ' + res.status, errText.slice(0, 100));
          return;
        }

        var beers = await res.json();

        if (!beers || beers.length === 0) {
          showStatus('&#x1F37A;', 'No beers on tap right now', 'Check back soon!');
          return;
        }

        var servingOrder = ['Draft', 'Bottle', 'Can', 'Crowler', 'Growler'];
        var groups = {};
        beers.forEach(function(b) {
          var k = b.serving || 'Draft';
          if (!groups[k]) groups[k] = [];
          groups[k].push(b);
        });

        var cardIndex = 0;
        var html = '<div class="menu-sections">';

        servingOrder
          .filter(function(k) { return groups[k] && groups[k].length > 0; })
          .forEach(function(k, sectionIdx) {
            var icon = servingIcons[k] || '🍺';
            var count = groups[k].length;

            html += '<div class="menu-section" style="animation-delay:' + (sectionIdx * 0.1) + 's">';

            html += '<div class="section-header">' +
              '<div class="section-icon">' + icon + '</div>' +
              '<span class="section-title">' + esc(k) + '</span>' +
              '<span class="section-count">' + count + '</span>' +
              '<div class="section-line"></div>' +
            '</div>';

            html += '<div class="beer-grid">';
            groups[k].forEach(function(beer) {
              html += renderCard(beer, cardIndex++);
            });
            html += '</div></div>';
          });

        html += '</div>';

        if (!isFirstLoad) {
          tvBody.style.opacity = '0';
          setTimeout(function() {
            tvBody.innerHTML = html;
            tvBody.style.opacity = '1';
          }, 300);
        } else {
          tvBody.innerHTML = html;
          isFirstLoad = false;
        }
      } catch (err) {
        showStatus('&#x26A0;', 'Could not load menu', String(err).slice(0, 80));
      }
    }

    fetchBeers();
    setInterval(fetchBeers, 60000);
  </script>
</body>
</html>
