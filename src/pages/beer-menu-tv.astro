---
/**
 * Full-screen beer menu display designed for bar TVs.
 * Multi-column card grid that fills the screen like a premium taproom board.
 * Auto-refreshes every 60 seconds with smooth crossfade.
 */
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>JTAPS Beer Menu</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg-0: #070707;
      --bg-1: #0f0f12;
      --ink-0: #f4efe6;
      --ink-1: #d4cfc7;
      --ink-2: #9e988f;
      --brand: #E13622;
      --brand-deep: #8a1f14;
      --panel: rgba(21, 21, 26, 0.78);
      --panel-border: rgba(255, 255, 255, 0.08);
      --shadow-lg: 0 14px 34px rgba(0, 0, 0, 0.45);
    }

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', sans-serif;
      background:
        radial-gradient(circle at 15% 10%, rgba(225,54,34,0.22), transparent 38%),
        radial-gradient(circle at 85% 18%, rgba(255,198,86,0.14), transparent 44%),
        linear-gradient(130deg, var(--bg-0) 0%, var(--bg-1) 50%, #0a0a0d 100%);
      color: var(--ink-0);
      height: 100vh;
      width: 100vw;
      overflow: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      background:
        linear-gradient(180deg, rgba(0,0,0,0.1), rgba(0,0,0,0.35)),
        repeating-linear-gradient(
          0deg,
          rgba(255,255,255,0.015) 0,
          rgba(255,255,255,0.015) 1px,
          transparent 1px,
          transparent 4px
        );
      mix-blend-mode: soft-light;
    }

    .tv-wrapper {
      position: relative;
      height: 100vh;
      width: 100vw;
      display: flex;
      flex-direction: column;
      padding: 0.8rem 1.2rem 0.4rem;
      backdrop-filter: saturate(108%);
    }

    /* ---- Header ---- */
    .tv-header {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      margin-bottom: 0.75rem;
      padding: 0.7rem 0.85rem 0.72rem;
      position: relative;
      border: 1px solid var(--panel-border);
      border-radius: 12px;
      background: linear-gradient(150deg, rgba(30,30,36,0.76), rgba(17,17,21,0.62));
      box-shadow: var(--shadow-lg);
      backdrop-filter: blur(6px);
    }

    .tv-header::after {
      content: '';
      position: absolute;
      bottom: -1px;
      left: 10px;
      right: 10px;
      height: 2px;
      border-radius: 10px;
      background: linear-gradient(90deg, transparent, rgba(225,54,34,0.62), transparent);
    }

    .header-logo {
      width: 44px;
      height: 44px;
      background: linear-gradient(140deg, var(--brand), var(--brand-deep));
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      line-height: 1;
      flex-shrink: 0;
      box-shadow: 0 10px 20px rgba(225,54,34,0.3);
    }

    .tv-header h1 {
      font-family: 'Oswald', sans-serif;
      font-size: clamp(1.85rem, 4.2vw, 2.85rem);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      line-height: 1;
      color: var(--ink-0);
      flex: 1;
      text-align: center;
      text-shadow: 0 3px 12px rgba(0,0,0,0.45);
    }

    .tv-header h1 .brand {
      color: #ff6e5e;
      text-shadow: 0 0 14px rgba(225,54,34,0.38);
    }

    .header-right {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 1.2rem;
    }

    .header-stats {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .stat-badge {
      font-family: 'Oswald', sans-serif;
      font-size: 0.64rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #b8b2aa;
      border: 1px solid rgba(255,255,255,0.14);
      border-radius: 6px;
      padding: 4px 10px;
      background: linear-gradient(145deg, rgba(255,255,255,0.06), rgba(255,255,255,0.015));
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.06);
    }

    .stat-badge strong {
      color: #ff9c91;
      font-weight: 700;
    }

    .header-live {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      font-family: 'Inter', sans-serif;
      font-size: 0.6rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #8f968e;
    }

    .live-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #22c55e;
      animation: pulse-dot 2s ease-in-out infinite;
    }

    @keyframes pulse-dot {
      0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(34,197,94,0.4); }
      50% { opacity: 0.6; box-shadow: 0 0 0 5px rgba(34,197,94,0); }
    }

    /* ---- Body ---- */
    .tv-body {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      transition: opacity 0.4s ease;
      scrollbar-width: none;
      padding: 0.2rem 0.15rem;
    }

    .tv-body::-webkit-scrollbar { display: none; }

    /* ---- Serving Section (matches admin grouped layout) ---- */
    .serving-section {
      margin-bottom: 0.95rem;
      padding: 0.72rem 0.78rem 0.84rem;
      border-radius: 12px;
      border: 1px solid var(--panel-border);
      background: linear-gradient(160deg, rgba(28,28,34,0.74), rgba(17,17,22,0.54));
      box-shadow: var(--shadow-lg);
      backdrop-filter: blur(5px);
    }

    .serving-header {
      font-family: 'Oswald', sans-serif;
      font-size: 0.9rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #d3cec6;
      margin-bottom: 0.62rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .serving-header .accent-bar {
      display: inline-block;
      width: 24px;
      height: 2px;
      background: linear-gradient(90deg, #ff6e5e, #E13622);
      flex-shrink: 0;
      border-radius: 4px;
    }

    .serving-header .divider-line {
      display: inline-block;
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, rgba(255,255,255,0.28), rgba(255,255,255,0.05));
    }

    .serving-header .serving-count {
      font-weight: 400;
      color: #a8a197;
      font-size: 0.75rem;
    }

    /* ---- Responsive grid (matches admin layout) ---- */
    .beer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 0.75rem;
    }

    /* ---- Beer Card ---- */
    .beer-card {
      background: linear-gradient(145deg, rgba(42,44,52,0.85), rgba(23,24,30,0.82));
      border: 1px solid rgba(255,255,255,0.09);
      border-left: 4px solid var(--brand);
      border-radius: 10px;
      padding: 0.85rem 0.95rem;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      animation: fadeIn 0.35s ease both;
      box-shadow: 0 8px 22px rgba(0,0,0,0.34);
    }

    .beer-card.is-featured {
      border-color: rgba(255,215,0,0.5);
      border-left-color: #FFD700;
      background: linear-gradient(145deg, rgba(72,58,26,0.86), rgba(34,30,20,0.9));
    }

    /* Card top row: name + price */
    .card-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .beer-name-block {
      flex: 1;
      min-width: 0;
    }

    .beer-name {
      font-family: 'Oswald', sans-serif;
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--ink-0);
      line-height: 1.15;
    }

    .beer-card.is-featured .beer-name .featured-star {
      margin-left: 0.35rem;
      font-size: 0.75rem;
    }

    .beer-price {
      font-family: 'Oswald', sans-serif;
      font-size: 1rem;
      font-weight: 700;
      color: #ff8b7d;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .beer-card.is-featured .beer-price {
      color: #FFD700;
    }

    /* Brewery */
    .beer-brewery {
      font-size: 0.75rem;
      color: var(--ink-2);
      margin-top: 0.1rem;
    }

    /* Tags row */
    .beer-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem;
    }

    .beer-style {
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #ff8e81;
      background: rgba(225,54,34,0.2);
      border: 1px solid rgba(225,54,34,0.42);
      border-radius: 3px;
      padding: 1px 6px;
    }

    .beer-card.is-featured .beer-style {
      color: #daa520;
      background: rgba(255,215,0,0.08);
      border-color: rgba(255,215,0,0.2);
    }

    .beer-abv, .beer-ibu {
      font-size: 0.7rem;
      font-weight: 600;
      color: #d8d4cd;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.14);
      border-radius: 3px;
      padding: 1px 6px;
    }

    .beer-ibu { color: #bab4ac; border-color: rgba(255,255,255,0.11); }

    /* Description */
    .beer-description {
      font-size: 0.78rem;
      color: #b6b0a6;
      font-style: italic;
      line-height: 1.4;
    }

    /* ---- Status / loading ---- */
    .status-message {
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.8rem;
    }

    .status-icon {
      font-size: 2.5rem;
      opacity: 0.15;
      animation: float 3s ease-in-out infinite;
    }

    .status-text {
      font-family: 'Oswald', sans-serif;
      font-size: 1.1rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #69645d;
    }

    .status-sub {
      font-size: 0.65rem;
      color: #555049;
    }

    .loading-bar {
      width: 100px;
      height: 2px;
      background: #151518;
      border-radius: 2px;
      overflow: hidden;
    }

    .loading-bar::after {
      content: '';
      display: block;
      width: 35%;
      height: 100%;
      background: #E13622;
      border-radius: 2px;
      animation: loadSlide 1.2s ease-in-out infinite;
    }

    /* ---- Footer ticker ---- */
    .tv-footer {
      flex-shrink: 0;
      margin-top: 0.6rem;
      padding: 0.7rem 0;
      border: 1px solid var(--panel-border);
      border-radius: 10px;
      background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(225,54,34,0.06));
      overflow: hidden;
      box-shadow: var(--shadow-lg);
    }

    .ticker-track {
      display: flex;
      white-space: nowrap;
      animation: ticker 40s linear infinite;
    }

    .ticker-item {
      font-family: 'Oswald', sans-serif;
      font-size: 0.95rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: #a8a096;
      padding: 0 2.2rem;
    }

    .ticker-dot { color: #E13622; font-size: 0.6rem; }

    /* ---- Animations ---- */
    @keyframes loadSlide {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(380%); }
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-5px); }
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @keyframes ticker {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }

    /* ---- Mobile responsive ---- */
    @media (max-width: 768px) {
      body { overflow: auto; height: auto; }

      .tv-wrapper {
        height: auto;
        min-height: 100vh;
        padding: 0.6rem 0.75rem 0.4rem;
      }

      .tv-header { flex-wrap: wrap; gap: 0.5rem; }

      .tv-header h1 { font-size: 1.5rem; letter-spacing: 0.08em; }

      .header-logo { width: 32px; height: 32px; font-size: 1rem; }

      .header-right { width: 100%; justify-content: center; }

      .header-stats { flex-wrap: wrap; justify-content: center; }

      .serving-section {
        padding: 0.65rem 0.62rem 0.72rem;
        border-radius: 10px;
      }

      .beer-grid {
        grid-template-columns: 1fr;
        gap: 0.6rem;
      }

      .serving-header { font-size: 0.75rem; }

      .tv-footer { display: none; }
    }

    @media (min-width: 769px) and (max-width: 1024px) {
      .beer-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  </style>
</head>
<body>
  <div class="tv-wrapper">
    <div class="tv-header">
      <div class="header-logo">&#x1F37A;</div>
      <h1><span class="brand">JTAPS</span> BEER MENU</h1>
      <div class="header-right">
        <div id="header-stats" class="header-stats"></div>
        <div class="header-live">
          <span class="live-dot"></span>
          Live
        </div>
      </div>
    </div>

    <div id="beer-tv-body" class="tv-body">
      <div class="status-message">
        <div class="status-icon">&#x1F37A;</div>
        <div class="status-text">Loading menu&hellip;</div>
        <div class="loading-bar"></div>
      </div>
    </div>

    <div class="tv-footer">
      <div class="ticker-track">
        <span class="ticker-item">Ask your server about today&#x27;s specials</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Cold drafts &middot; Craft bottles &middot; Bar snacks</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Happy hour Mon&ndash;Fri 4&ndash;7 PM</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Watch every game right here at JTAPS</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Ask your server about today&#x27;s specials</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Cold drafts &middot; Craft bottles &middot; Bar snacks</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Happy hour Mon&ndash;Fri 4&ndash;7 PM</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Watch every game right here at JTAPS</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ SUPABASE_URL, SUPABASE_KEY }}>
    var tvBody = document.getElementById('beer-tv-body');
    var headerStats = document.getElementById('header-stats');
    var isFirstLoad = true;

    var servingIcons = {
      'Draft': '\u{1F37A}', 'Bottle': '\u{1F37E}', 'Can': '\u{1F964}',
      'Crowler': '\u{1FAD9}', 'Growler': '\u{1F37B}'
    };

    function showStatus(icon, text, sub) {
      tvBody.innerHTML =
        '<div class="status-message">' +
          '<div class="status-icon">' + icon + '</div>' +
          '<div class="status-text">' + text + '</div>' +
          (sub ? '<div class="status-sub">' + sub + '</div>' : '') +
        '</div>';
    }

    function esc(str) {
      if (!str) return '';
      var d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    function renderCard(beer, index) {
      var cls = 'beer-card' + (beer.featured ? ' is-featured' : '');
      var delay = isFirstLoad ? ' style="animation-delay:' + (index * 0.03) + 's"' : '';

      var price = beer.price != null
        ? '<span class="beer-price">$' + Number(beer.price).toFixed(2) + '</span>'
        : '';

      var star = beer.featured ? '<span class="featured-star">\u2B50</span>' : '';

      var brewery = beer.brewery
        ? '<div class="beer-brewery">' + esc(beer.brewery) + '</div>'
        : '';

      var tags = '';
      if (beer.style || beer.abv != null || beer.ibu != null) {
        tags = '<div class="beer-tags">';
        if (beer.style) tags += '<span class="beer-style">' + esc(beer.style) + '</span>';
        if (beer.abv != null) tags += '<span class="beer-abv">' + beer.abv + '% ABV</span>';
        if (beer.ibu != null) tags += '<span class="beer-ibu">' + beer.ibu + ' IBU</span>';
        tags += '</div>';
      }

      var desc = beer.description
        ? '<div class="beer-description">' + esc(beer.description) + '</div>'
        : '';

      return '<div class="' + cls + '"' + delay + '>' +
        '<div class="card-top">' +
          '<div class="beer-name-block">' +
            '<span class="beer-name">' + esc(beer.name) + star + '</span>' +
            brewery +
          '</div>' +
          price +
        '</div>' +
        tags +
        desc +
      '</div>';
    }

    async function fetchBeers() {
      if (!SUPABASE_URL || !SUPABASE_KEY || SUPABASE_URL === 'undefined') {
        showStatus('\u26A0', 'Supabase not configured', 'Check environment variables');
        return;
      }

      try {
        var url = SUPABASE_URL + '/rest/v1/beer_menu?select=*&available=eq.true&order=sort_order.asc,name.asc';
        var res = await fetch(url, {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': 'Bearer ' + SUPABASE_KEY,
            'Content-Type': 'application/json'
          }
        });

        if (!res.ok) {
          var errText = await res.text();
          showStatus('\u26A0', 'Error ' + res.status, errText.slice(0, 100));
          return;
        }

        var beers = await res.json();

        if (!beers || beers.length === 0) {
          showStatus('\u{1F37A}', 'No beers on tap right now', 'Check back soon!');
          return;
        }

        /* Group by serving type */
        var servingOrder = ['Draft', 'Bottle', 'Can', 'Crowler', 'Growler'];
        var groups = {};
        beers.forEach(function(b) {
          var k = b.serving || 'Draft';
          if (!groups[k]) groups[k] = [];
          groups[k].push(b);
        });

        /* Build grouped sections (like admin layout) */
        var html = '';
        var cardIdx = 0;
        var servingSections = [];

        servingOrder.forEach(function(k) {
          if (groups[k] && groups[k].length > 0) {
            var icon = servingIcons[k] || '\u{1F37A}';
            var count = groups[k].length;
            servingSections.push({ key: k, count: count });

            html += '<div class="serving-section">';
            html += '<div class="serving-header">';
            html += '<span class="accent-bar"></span>';
            html += icon + ' ' + esc(k);
            html += '<span class="divider-line"></span>';
            html += '<span class="serving-count">' + count + ' beer' + (count !== 1 ? 's' : '') + '</span>';
            html += '</div>';
            html += '<div class="beer-grid">';
            groups[k].forEach(function(beer) {
              html += renderCard(beer, cardIdx++);
            });
            html += '</div>';
            html += '</div>';
          }
        });

        /* Update header stat badges */
        var statsHtml = '';
        servingSections.forEach(function(s) {
          var icon = servingIcons[s.key] || '\u{1F37A}';
          statsHtml += '<span class="stat-badge">' + icon + ' <strong>' + s.count + '</strong> ' + esc(s.key) + '</span>';
        });
        headerStats.innerHTML = statsHtml;

        /* Render with crossfade on refresh */
        if (!isFirstLoad) {
          tvBody.style.opacity = '0';
          setTimeout(function() {
            tvBody.innerHTML = html;
            tvBody.style.opacity = '1';
          }, 300);
        } else {
          tvBody.innerHTML = html;
          isFirstLoad = false;
        }
      } catch (err) {
        showStatus('\u26A0', 'Could not load menu', String(err).slice(0, 80));
      }
    }

    fetchBeers();
    setInterval(fetchBeers, 60000);
  </script>
</body>
</html>
