<body>
  <div id="beer-tv-root">
    <div class="loading">🍺 &nbsp; Loading Beer Menu...</div>
  </div>

  <script is:inline define:vars={{ SUPABASE_URL, SUPABASE_KEY }}>
    const REFRESH_INTERVAL = 60000;

    async function fetchBeers() {
      if (!SUPABASE_URL || !SUPABASE_KEY) {
        document.getElementById('beer-tv-root').innerHTML =
          '<div class="loading">⚠️ Supabase not configured</div>';
        return;
      }
      try {
        const url = `${SUPABASE_URL}/rest/v1/beer_menu?available=eq.true&order=sort_order.asc,name.asc&select=*`;
        const res = await fetch(url, {
          headers: { 'apikey': SUPABASE_KEY, 'Authorization': `Bearer ${SUPABASE_KEY}` }
        });
        if (!res.ok) throw new Error('Failed to fetch');
        renderMenu(await res.json());
      } catch (err) {
        console.error('Beer menu fetch error:', err);
      }
    }

    function esc(str) {
      if (!str) return '';
      const d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    function renderBeerRow(beer) {
      const featured = beer.featured ? 'is-featured' : '';
      const abvBadge = beer.abv != null
        ? `<span class="abv-badge">${beer.abv}% ABV</span>` : '';
      const styleBadge = beer.style
        ? `<span class="style-badge">${esc(beer.style)}</span>` : '';
      const price = beer.price != null
        ? `<span class="beer-leader"></span><span class="beer-price">$${Number(beer.price).toFixed(2)}</span>`
        : '';
      const brewery = beer.brewery
        ? `<div class="beer-brewery">${esc(beer.brewery)}</div>` : '';
      const desc = beer.description
        ? `<div class="beer-description">${esc(beer.description)}</div>` : '';

      return `
        <div class="beer-item ${featured}">
          <div class="beer-info">
            <div class="beer-name-row">
              <span class="beer-name">${esc(beer.name)}</span>
              ${styleBadge}${abvBadge}
            </div>
            ${brewery}${desc}
          </div>
          ${price}
        </div>`;
    }

    function renderColumn(sections) {
      return sections.map(s => `
        <div class="section-title"><span class="title-icon">🍺</span>${esc(s.title)}</div>
        <div class="beer-list">${s.items.map(renderBeerRow).join('')}</div>
      `).join('');
    }

    function renderMenu(beers) {
      const root = document.getElementById('beer-tv-root');

      if (!beers || beers.length === 0) {
        root.innerHTML = `
          <div class="tv-container">
            <div class="tv-header">
              <span class="header-logo">🍺</span>
              <div class="header-text"><h1><span class="brand">JTAPS</span> BEER MENU</h1></div>
            </div>
            <div class="empty-state">Check back soon — beers loading...</div>
          </div>`;
        return;
      }

      // Group by serving type in display order
      const servingOrder = ['Draft', 'Bottle', 'Can', 'Crowler', 'Growler'];
      const groups = {};
      beers.forEach(b => {
        const k = b.serving || 'Draft';
        if (!groups[k]) groups[k] = [];
        groups[k].push(b);
      });
      const allSections = servingOrder
        .filter(k => groups[k] && groups[k].length > 0)
        .map(k => ({ title: k, items: groups[k] }));

      // Balance two columns by item count
      const total = beers.length;
      let left = 0, splitIdx = allSections.length;
      for (let i = 0; i < allSections.length; i++) {
        left += allSections[i].items.length;
        if (left >= total / 2) { splitIdx = i + 1; break; }
      }
      const leftSections  = allSections.slice(0, splitIdx);
      const rightSections = allSections.slice(splitIdx);

      // Ticker phrases
      const tickerContent = [
        'Ask your server about today\'s specials',
        '🍺',
        'Cold drafts · Craft bottles · Bar snacks',
        '🍺',
        'Happy hour Mon–Fri 4–7 PM',
        '🍺',
        'Watch every game right here at JTAPS',
        '🍺',
        'Ask your server about today\'s specials',
        '🍺',
        'Cold drafts · Craft bottles · Bar snacks',
        '🍺',
        'Happy hour Mon–Fri 4–7 PM',
        '🍺',
        'Watch every game right here at JTAPS',
        '🍺',
      ].map(t => `<span class="ticker-item">${t === '🍺' ? '<span class="ticker-dot">✦</span>' : esc(t)}</span>`).join('');

      root.innerHTML = `
        <div class="tv-container">
          <div class="tv-header">
            <span class="header-logo">🍺</span>
            <div class="header-text">
              <h1><span class="brand">JTAPS</span> BEER MENU</h1>
              <div class="tagline">Bar &amp; Grill &nbsp;·&nbsp; Cincinnati, OH</div>
            </div>
          </div>
          <div class="tv-body">
            <div class="beer-column">${renderColumn(leftSections)}</div>
            ${rightSections.length > 0
              ? `<div class="beer-column">${renderColumn(rightSections)}</div>`
              : ''}
          </div>
          <div class="tv-footer">
            <div class="ticker-track">${tickerContent}</div>
          </div>
        </div>`;
    }

    fetchBeers();
    setInterval(fetchBeers, REFRESH_INTERVAL);
  </script>
</body>
</html>
