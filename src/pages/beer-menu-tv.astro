---
/**
 * Full-screen beer menu display designed for bar TVs.
 * Auto-refreshes every 60 seconds.
 */
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>JTAPS Beer Menu</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Open Sans', sans-serif;
      background: #111214;
      color: #f0ece4;
      height: 100vh;
      width: 100vw;
      overflow: hidden;
    }

    .tv-wrapper {
      height: 100vh;
      width: 100vw;
      display: flex;
      flex-direction: column;
      padding: 1.5rem 2.5rem 1rem;
    }

    /* ---- Header ---- */
    .tv-header {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.5rem;
      margin-bottom: 1rem;
      padding-bottom: 1rem;
      border-bottom: 2px solid #2a2a2a;
      position: relative;
    }

    .tv-header::after {
      content: '';
      position: absolute;
      bottom: -5px;
      left: 10%;
      right: 10%;
      height: 2px;
      background: linear-gradient(90deg, transparent, #E13622 20%, #E13622 80%, transparent);
    }

    .header-icon {
      font-size: 3rem;
      line-height: 1;
    }

    .header-text { text-align: center; }

    .tv-header h1 {
      font-family: 'Oswald', sans-serif;
      font-size: 3.2rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      line-height: 1;
      color: #fff;
    }

    .tv-header h1 .brand { color: #E13622; }

    .tv-header .tagline {
      font-family: 'Oswald', sans-serif;
      font-size: 0.9rem;
      color: #777;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      margin-top: 0.3rem;
    }

    /* ---- Body ---- */
    .tv-body {
      flex: 1;
      overflow: hidden;
      min-height: 0;
    }

    .beer-sections {
      height: 100%;
      overflow: hidden;
    }

    .section-block {
      margin-bottom: 0.75rem;
    }

    .section-heading {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-family: 'Oswald', sans-serif;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.35em;
      text-transform: uppercase;
      color: #E13622;
      margin-bottom: 0.5rem;
    }

    .section-heading::after {
      content: '';
      flex: 1;
      height: 1px;
      background: #252525;
    }

    /* ---- Beer card grid ---- */
    .beer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 0.5rem;
    }

    /* ---- Beer card ---- */
    .beer-card {
      background: #18191b;
      border: 1px solid #252528;
      border-top: 3px solid #2e2e30;
      border-radius: 5px;
      padding: 0.7rem 0.9rem;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .beer-card.is-featured {
      border-top-color: #FFD700;
      background: #1c1b14;
    }

    .beer-card-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.5rem;
    }

    .beer-card-name {
      font-family: 'Oswald', sans-serif;
      font-size: 1.1rem;
      font-weight: 600;
      color: #e8e4dc;
      line-height: 1.2;
    }

    .beer-card.is-featured .beer-card-name { color: #fff; }

    .beer-card-price {
      font-family: 'Oswald', sans-serif;
      font-size: 1.2rem;
      font-weight: 700;
      color: #999;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .beer-card.is-featured .beer-card-price { color: #FFD700; }

    .beer-card-brewery {
      font-size: 0.67rem;
      color: #4a4a4c;
      letter-spacing: 0.02em;
    }

    .beer-card-badges {
      display: flex;
      align-items: center;
      gap: 0.3rem;
      flex-wrap: wrap;
      margin-top: 0.1rem;
    }

    .style-badge {
      font-size: 0.58rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #E13622;
      background: rgba(225,54,34,0.1);
      border: 1px solid rgba(225,54,34,0.2);
      border-radius: 3px;
      padding: 0.1rem 0.4rem;
      white-space: nowrap;
    }

    .abv-badge {
      font-size: 0.58rem;
      font-weight: 600;
      color: #666;
      background: rgba(255,255,255,0.04);
      border: 1px solid #2c2c2c;
      border-radius: 3px;
      padding: 0.1rem 0.35rem;
      white-space: nowrap;
      letter-spacing: 0.03em;
    }

    .beer-card-desc {
      font-size: 0.65rem;
      color: #444;
      font-style: italic;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      line-height: 1.4;
      margin-top: 0.05rem;
    }

    /* ---- Status states ---- */
    .status-message {
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
    }

    .status-icon {
      font-size: 3rem;
      opacity: 0.35;
    }

    .status-text {
      font-family: 'Oswald', sans-serif;
      font-size: 1.3rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #444;
    }

    .status-sub {
      font-size: 0.78rem;
      color: #333;
      letter-spacing: 0.05em;
    }

    /* ---- Footer ticker ---- */
    .tv-footer {
      flex-shrink: 0;
      margin-top: 0.6rem;
      padding-top: 0.5rem;
      border-top: 1px solid #1c1c1c;
      overflow: hidden;
    }

    .ticker-track {
      display: flex;
      white-space: nowrap;
      animation: ticker 35s linear infinite;
    }

    .ticker-track:hover { animation-play-state: paused; }

    .ticker-item {
      font-family: 'Oswald', sans-serif;
      font-size: 0.85rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: #3a3a3a;
      padding: 0 2.5rem;
    }

    .ticker-dot { color: #E13622; }

    @keyframes ticker {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }
  </style>
</head>
<body>
  <div class="tv-wrapper">
    <div class="tv-header">
      <div class="header-icon">&#x1F37A;</div>
      <div class="header-text">
        <h1><span class="brand">JTAPS</span> BEER MENU</h1>
        <div class="tagline">Bar &amp; Grill &nbsp;&middot;&nbsp; Cincinnati, OH</div>
      </div>
    </div>

    <div id="beer-tv-body" class="tv-body">
      <div class="status-message">
        <div class="status-icon">&#x1F37A;</div>
        <div class="status-text">Loading menu...</div>
      </div>
    </div>

    <div class="tv-footer">
      <div class="ticker-track">
        <span class="ticker-item">Ask your server about today&#x27;s specials</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Cold drafts &middot; Craft bottles &middot; Bar snacks</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Happy hour Mon&ndash;Fri 4&ndash;7 PM</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Watch every game right here at JTAPS</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Ask your server about today&#x27;s specials</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Cold drafts &middot; Craft bottles &middot; Bar snacks</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Happy hour Mon&ndash;Fri 4&ndash;7 PM</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Watch every game right here at JTAPS</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ SUPABASE_URL, SUPABASE_KEY }}>
    var tvBody = document.getElementById('beer-tv-body');

    function showStatus(icon, text, sub) {
      tvBody.innerHTML =
        '<div class="status-message">' +
        '<div class="status-icon">' + icon + '</div>' +
        '<div class="status-text">' + text + '</div>' +
        (sub ? '<div class="status-sub">' + sub + '</div>' : '') +
        '</div>';
    }

    function esc(str) {
      if (!str) return '';
      var d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    function renderCard(beer) {
      var featured = beer.featured ? 'is-featured' : '';
      var price = beer.price != null
        ? '<div class="beer-card-price">$' + Number(beer.price).toFixed(2) + '</div>'
        : '';
      var brewery = beer.brewery
        ? '<div class="beer-card-brewery">' + esc(beer.brewery) + '</div>'
        : '';
      var styleBadge = beer.style
        ? '<span class="style-badge">' + esc(beer.style) + '</span>'
        : '';
      var abvBadge = beer.abv != null
        ? '<span class="abv-badge">' + beer.abv + '% ABV</span>'
        : '';
      var badges = (styleBadge || abvBadge)
        ? '<div class="beer-card-badges">' + styleBadge + abvBadge + '</div>'
        : '';
      var desc = beer.description
        ? '<div class="beer-card-desc">' + esc(beer.description) + '</div>'
        : '';
      return (
        '<div class="beer-card ' + featured + '">' +
          '<div class="beer-card-header">' +
            '<div class="beer-card-name">' + esc(beer.name) + '</div>' +
            price +
          '</div>' +
          brewery +
          badges +
          desc +
        '</div>'
      );
    }

    async function fetchBeers() {
      if (!SUPABASE_URL || !SUPABASE_KEY || SUPABASE_URL === 'undefined') {
        showStatus('&#x26A0;', 'Supabase not configured', 'Check environment variables');
        return;
      }

      try {
        var url = SUPABASE_URL + '/rest/v1/beer_menu?select=*&available=eq.true&order=sort_order.asc,name.asc';
        var res = await fetch(url, {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': 'Bearer ' + SUPABASE_KEY,
            'Content-Type': 'application/json'
          }
        });

        if (!res.ok) {
          var errText = await res.text();
          showStatus('&#x26A0;', 'Error ' + res.status, errText.slice(0, 100));
          return;
        }

        var beers = await res.json();

        if (!beers || beers.length === 0) {
          showStatus('&#x1F37A;', 'No beers on tap right now', 'Check back soon!');
          return;
        }

        var servingOrder = ['Draft', 'Bottle', 'Can', 'Crowler', 'Growler'];
        var groups = {};
        beers.forEach(function(b) {
          var k = b.serving || 'Draft';
          if (!groups[k]) groups[k] = [];
          groups[k].push(b);
        });

        var html = servingOrder
          .filter(function(k) { return groups[k] && groups[k].length > 0; })
          .map(function(k) {
            var cards = groups[k].map(renderCard).join('');
            return (
              '<div class="section-block">' +
                '<div class="section-heading">' + esc(k) + '</div>' +
                '<div class="beer-grid">' + cards + '</div>' +
              '</div>'
            );
          }).join('');

        tvBody.innerHTML = '<div class="beer-sections">' + html + '</div>';
      } catch (err) {
        showStatus('&#x26A0;', 'Could not load menu', String(err).slice(0, 80));
      }
    }

    fetchBeers();
    setInterval(fetchBeers, 60000);
  </script>
</body>
</html>
