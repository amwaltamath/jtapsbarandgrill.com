---
/**
 * Full-screen beer menu display designed for bar TVs.
 * Multi-column card grid that fills the screen like a premium taproom board.
 * Auto-refreshes every 60 seconds with smooth crossfade.
 */
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>JTAPS Beer Menu</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', sans-serif;
      background: #0b0c0e;
      color: #e8e4dc;
      height: 100vh;
      width: 100vw;
      overflow: hidden;
    }

    .tv-wrapper {
      position: relative;
      height: 100vh;
      width: 100vw;
      display: flex;
      flex-direction: column;
      padding: 0.8rem 1.2rem 0.4rem;
    }

    /* ---- Header ---- */
    .tv-header {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 0.6rem;
      padding-bottom: 0.6rem;
      position: relative;
    }

    .tv-header::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, #E13622, rgba(225,54,34,0.15) 60%, transparent);
    }

    .header-logo {
      width: 42px;
      height: 42px;
      background: linear-gradient(135deg, #E13622, #b8200e);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      line-height: 1;
      flex-shrink: 0;
    }

    .tv-header h1 {
      font-family: 'Oswald', sans-serif;
      font-size: 1.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      line-height: 1;
      color: #fff;
    }

    .tv-header h1 .brand { color: #E13622; }

    .header-right {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 1.2rem;
    }

    .header-stats {
      display: flex;
      gap: 0.5rem;
    }

    .stat-badge {
      font-family: 'Oswald', sans-serif;
      font-size: 0.65rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #666;
      border: 1px solid #222;
      border-radius: 6px;
      padding: 3px 10px;
      background: rgba(255,255,255,0.02);
    }

    .stat-badge strong {
      color: #E13622;
      font-weight: 700;
    }

    .header-live {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      font-family: 'Inter', sans-serif;
      font-size: 0.6rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #444;
    }

    .live-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #22c55e;
      animation: pulse-dot 2s ease-in-out infinite;
    }

    @keyframes pulse-dot {
      0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(34,197,94,0.4); }
      50% { opacity: 0.6; box-shadow: 0 0 0 5px rgba(34,197,94,0); }
    }

    /* ---- Body ---- */
    .tv-body {
      flex: 1;
      min-height: 0;
      overflow: hidden;
      transition: opacity 0.4s ease;
    }

    /* ---- Multi-column newspaper-style flow ---- */
    .beer-column-flow {
      height: 100%;
      column-gap: 10px;
      /* column-count set dynamically via JS */
    }

    /* ---- Beer Card — visible tile design ---- */
    .beer-card {
      break-inside: avoid;
      background: #16181c;
      border: 1px solid #2a2c32;
      border-radius: 8px;
      padding: 10px 12px;
      margin-bottom: 8px;
      position: relative;
      overflow: hidden;
      animation: fadeIn 0.35s ease both;
    }

    /* Top accent stripe */
    .beer-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, #E13622, rgba(225,54,34,0.2));
    }

    .beer-card.is-featured {
      border-color: rgba(255,215,0,0.35);
      background: linear-gradient(160deg, #1e1c10, #16181c 70%);
    }

    .beer-card.is-featured::before {
      background: linear-gradient(90deg, #FFD700, rgba(255,215,0,0.2));
    }

    .beer-card.is-featured .featured-star {
      position: absolute;
      top: 7px;
      right: 8px;
      font-size: 0.6rem;
      color: #FFD700;
      opacity: 0.8;
    }

    /* Card top row: name + price */
    .card-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 8px;
    }

    .beer-name {
      font-family: 'Oswald', sans-serif;
      font-size: 1rem;
      font-weight: 600;
      color: #fff;
      line-height: 1.15;
      flex: 1;
    }

    .beer-price {
      font-family: 'Oswald', sans-serif;
      font-size: 1rem;
      font-weight: 700;
      color: #E13622;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .beer-card.is-featured .beer-price {
      color: #FFD700;
    }

    /* Brewery */
    .beer-brewery {
      font-size: 0.65rem;
      color: #777;
      margin-top: 1px;
      font-weight: 500;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Tags row */
    .beer-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin-top: 5px;
    }

    .beer-style {
      font-size: 0.55rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #E13622;
      background: rgba(225,54,34,0.1);
      border: 1px solid rgba(225,54,34,0.25);
      border-radius: 3px;
      padding: 2px 6px;
    }

    .beer-card.is-featured .beer-style {
      color: #daa520;
      background: rgba(255,215,0,0.08);
      border-color: rgba(255,215,0,0.2);
    }

    .beer-abv {
      font-size: 0.55rem;
      font-weight: 600;
      color: #888;
      background: rgba(255,255,255,0.04);
      border: 1px solid #333;
      border-radius: 3px;
      padding: 2px 6px;
    }

    .beer-ibu {
      font-size: 0.55rem;
      font-weight: 600;
      color: #666;
      background: rgba(255,255,255,0.03);
      border: 1px solid #2a2a2d;
      border-radius: 3px;
      padding: 2px 6px;
    }

    /* ---- Status / loading ---- */
    .status-message {
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.8rem;
    }

    .status-icon {
      font-size: 2.5rem;
      opacity: 0.15;
      animation: float 3s ease-in-out infinite;
    }

    .status-text {
      font-family: 'Oswald', sans-serif;
      font-size: 1.1rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: #2a2a2d;
    }

    .status-sub {
      font-size: 0.65rem;
      color: #222;
    }

    .loading-bar {
      width: 100px;
      height: 2px;
      background: #151518;
      border-radius: 2px;
      overflow: hidden;
    }

    .loading-bar::after {
      content: '';
      display: block;
      width: 35%;
      height: 100%;
      background: #E13622;
      border-radius: 2px;
      animation: loadSlide 1.2s ease-in-out infinite;
    }

    /* ---- Footer ticker ---- */
    .tv-footer {
      flex-shrink: 0;
      margin-top: 0.4rem;
      padding-top: 0.35rem;
      border-top: 1px solid #141417;
      overflow: hidden;
    }

    .ticker-track {
      display: flex;
      white-space: nowrap;
      animation: ticker 40s linear infinite;
    }

    .ticker-item {
      font-family: 'Inter', sans-serif;
      font-size: 0.62rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #2a2a2d;
      padding: 0 1.8rem;
    }

    .ticker-dot { color: #E13622; font-size: 0.45rem; }

    /* ---- Animations ---- */
    @keyframes loadSlide {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(380%); }
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-5px); }
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @keyframes ticker {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }
  </style>
</head>
<body>
  <div class="tv-wrapper">
    <div class="tv-header">
      <div class="header-logo">&#x1F37A;</div>
      <h1><span class="brand">JTAPS</span> BEER MENU</h1>
      <div class="header-right">
        <div id="header-stats" class="header-stats"></div>
        <div class="header-live">
          <span class="live-dot"></span>
          Live
        </div>
      </div>
    </div>

    <div id="beer-tv-body" class="tv-body">
      <div class="status-message">
        <div class="status-icon">&#x1F37A;</div>
        <div class="status-text">Loading menu&hellip;</div>
        <div class="loading-bar"></div>
      </div>
    </div>

    <div class="tv-footer">
      <div class="ticker-track">
        <span class="ticker-item">Ask your server about today&#x27;s specials</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Cold drafts &middot; Craft bottles &middot; Bar snacks</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Happy hour Mon&ndash;Fri 4&ndash;7 PM</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Watch every game right here at JTAPS</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Ask your server about today&#x27;s specials</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Cold drafts &middot; Craft bottles &middot; Bar snacks</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Happy hour Mon&ndash;Fri 4&ndash;7 PM</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
        <span class="ticker-item">Watch every game right here at JTAPS</span>
        <span class="ticker-item"><span class="ticker-dot">&#x2726;</span></span>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ SUPABASE_URL, SUPABASE_KEY }}>
    var tvBody = document.getElementById('beer-tv-body');
    var headerStats = document.getElementById('header-stats');
    var isFirstLoad = true;

    var servingIcons = {
      'Draft': '\u{1F37A}', 'Bottle': '\u{1F37E}', 'Can': '\u{1F964}',
      'Crowler': '\u{1FAD9}', 'Growler': '\u{1F37B}'
    };

    function showStatus(icon, text, sub) {
      tvBody.innerHTML =
        '<div class="status-message">' +
          '<div class="status-icon">' + icon + '</div>' +
          '<div class="status-text">' + text + '</div>' +
          (sub ? '<div class="status-sub">' + sub + '</div>' : '') +
        '</div>';
    }

    function esc(str) {
      if (!str) return '';
      var d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    function renderCard(beer, index) {
      var cls = 'beer-card' + (beer.featured ? ' is-featured' : '');
      var delay = isFirstLoad ? ' style="animation-delay:' + (index * 0.03) + 's"' : '';

      var price = beer.price != null
        ? '<span class="beer-price">$' + Number(beer.price).toFixed(2) + '</span>'
        : '';

      var brewery = beer.brewery
        ? '<div class="beer-brewery">' + esc(beer.brewery) + '</div>'
        : '';

      var star = beer.featured ? '<span class="featured-star">\u2605</span>' : '';

      var tags = '';
      if (beer.style || beer.abv != null || beer.ibu != null) {
        tags = '<div class="beer-tags">';
        if (beer.style) tags += '<span class="beer-style">' + esc(beer.style) + '</span>';
        if (beer.abv != null) tags += '<span class="beer-abv">' + beer.abv + '% ABV</span>';
        if (beer.ibu != null) tags += '<span class="beer-ibu">' + beer.ibu + ' IBU</span>';
        tags += '</div>';
      }

      return '<div class="' + cls + '"' + delay + '>' +
        star +
        '<div class="card-top">' +
          '<span class="beer-name">' + esc(beer.name) + '</span>' +
          price +
        '</div>' +
        brewery +
        tags +
      '</div>';
    }

    async function fetchBeers() {
      if (!SUPABASE_URL || !SUPABASE_KEY || SUPABASE_URL === 'undefined') {
        showStatus('\u26A0', 'Supabase not configured', 'Check environment variables');
        return;
      }

      try {
        var url = SUPABASE_URL + '/rest/v1/beer_menu?select=*&available=eq.true&order=sort_order.asc,name.asc';
        var res = await fetch(url, {
          headers: {
            'apikey': SUPABASE_KEY,
            'Authorization': 'Bearer ' + SUPABASE_KEY,
            'Content-Type': 'application/json'
          }
        });

        if (!res.ok) {
          var errText = await res.text();
          showStatus('\u26A0', 'Error ' + res.status, errText.slice(0, 100));
          return;
        }

        var beers = await res.json();

        if (!beers || beers.length === 0) {
          showStatus('\u{1F37A}', 'No beers on tap right now', 'Check back soon!');
          return;
        }

        /* Group by serving type */
        var servingOrder = ['Draft', 'Bottle', 'Can', 'Crowler', 'Growler'];
        var groups = {};
        beers.forEach(function(b) {
          var k = b.serving || 'Draft';
          if (!groups[k]) groups[k] = [];
          groups[k].push(b);
        });

        /* Flatten beers in serving order */
        var orderedBeers = [];
        var servingSections = [];
        servingOrder.forEach(function(k) {
          if (groups[k] && groups[k].length > 0) {
            servingSections.push({ key: k, count: groups[k].length });
            orderedBeers = orderedBeers.concat(groups[k]);
          }
        });

        /* Calculate columns: aim for ~7 cards per column on a 1080p TV */
        var totalBeers = orderedBeers.length;
        var colCount = Math.min(5, Math.max(3, Math.ceil(totalBeers / 7)));

        /* Build multi-column layout — CSS columns flow top-to-bottom, left-to-right */
        var html = '<div class="beer-column-flow" style="column-count:' + colCount + ';">';

        var cardIdx = 0;
        orderedBeers.forEach(function(beer) {
          html += renderCard(beer, cardIdx++);
        });

        html += '</div>';

        /* Update header stat badges */
        var statsHtml = '';
        servingSections.forEach(function(s) {
          var icon = servingIcons[s.key] || '\u{1F37A}';
          statsHtml += '<span class="stat-badge">' + icon + ' <strong>' + s.count + '</strong> ' + esc(s.key) + '</span>';
        });
        headerStats.innerHTML = statsHtml;

        /* Render with crossfade on refresh */
        if (!isFirstLoad) {
          tvBody.style.opacity = '0';
          setTimeout(function() {
            tvBody.innerHTML = html;
            tvBody.style.opacity = '1';
          }, 300);
        } else {
          tvBody.innerHTML = html;
          isFirstLoad = false;
        }
      } catch (err) {
        showStatus('\u26A0', 'Could not load menu', String(err).slice(0, 80));
      }
    }

    fetchBeers();
    setInterval(fetchBeers, 60000);
  </script>
</body>
</html>
