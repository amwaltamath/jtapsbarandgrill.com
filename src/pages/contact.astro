---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contact & Location - JTAPS Bar and Grill Cincinnati"
  description="📍 Visit JTAPS at 6441 Glenway Ave, Cincinnati. Call (513) 574-9777 now! Best sports bar with outdoor dining. Order online or reserve your table today!"
  keywords="jtaps location, jtaps cincinnati, glenway ave restaurant, cincinnati sports bar location, jtaps hours, jtaps contact"
  ogImage="/images/6441-Glenway-front.jpg"
>
  <div class="contact-page">
    <section class="contact-hero">
      <h1>Visit Us</h1>
      <p class="subtitle">CINCINNATI'S FAVORITE SPORTS BAR SINCE 2006</p>
    </section>

    <section class="contact-info">
      <div class="container">
        <div class="info-grid">
          <div class="info-card">
            <h2>📍 Location</h2>
            <p>
              <strong>JTAPS Bar and Grill</strong><br>
              6441 Glenway Ave<br>
              Cincinnati, OH 45211
            </p>
            <a href="https://www.google.com/maps/search/?api=1&query=6441+Glenway+Ave+Cincinnati+OH" 
               target="_blank" 
               class="map-button">Get Directions</a>
          </div>

          <div class="info-card">
            <h2>📞 Contact</h2>
            <p>
              <strong>Phone:</strong> <a href="tel:+15135749777">(513) 574-9777</a><br>
              <strong>Email:</strong> info@jtapsbarandgrill.com
            </p>
            <div class="social-links">
              <a href="https://www.facebook.com/JTAPS" target="_blank" rel="noopener">Facebook</a>
              <a href="https://www.instagram.com/jtapsbarandgrill" target="_blank" rel="noopener">Instagram</a>
            </div>
          </div>

          <div class="info-card">
            <h2>🕒 Hours</h2>
            <p>
              <strong>Monday - Thursday:</strong> 11am - 11pm<br>
              <strong>Friday - Saturday:</strong> 11am - 1am<br>
              <strong>Sunday:</strong> 11am - 10pm
            </p>
            <p class="hours-note">*Hours may vary on holidays and game days</p>
          </div>
        </div>      </div>
    </section>
    <section class="contact-form-section">
      <div class="container contact-form-layout">
        <div class="contact-form-copy">
          <p class="eyebrow">Get In Touch</p>
          <h2>Sent us a message</h2>
          <p>
            Questions about events, reservations, or private parties? Send a note and we will get it directly.
          </p>
          <ul class="contact-points">
            <li>Fast response for general inquiries and events</li>
            <li>Use the form instead of sending a separate email</li>
            <li>All fields are optional except the basics we need to reply</li>
          </ul>
        </div>

        <form id="contact-form" class="contact-form" novalidate>
          <div class="form-grid">
            <label>
              <span>Name</span>
              <input type="text" name="name" autocomplete="name" placeholder="Your name" required>
            </label>

            <label>
              <span>Email</span>
              <input type="email" name="email" autocomplete="email" placeholder="you@example.com" required>
            </label>

            <label>
              <span>Phone</span>
              <input type="tel" name="phone" autocomplete="tel" placeholder="(513) 555-0123">
            </label>

            <label>
              <span>Subject</span>
              <input type="text" name="subject" placeholder="How can we help?" required>
            </label>
          </div>

          <label class="message-field">
            <span>Message</span>
            <textarea name="message" rows="6" placeholder="Tell us about your event, question, or request." required></textarea>
          </label>

          <div class="form-honeypot" aria-hidden="true">
            <label>
              <span>Website</span>
              <input type="text" name="website" tabindex="-1" autocomplete="off">
            </label>
          </div>

          <p class="form-status" id="contact-form-status" role="status" aria-live="polite"></p>

          <button type="submit" class="form-submit">Send Message</button>
        </form>

        <div id="contact-thank-you" class="thank-you-state" hidden tabindex="-1">
          <span class="thank-you-icon" aria-hidden="true">✅</span>
          <h3>Message sent!</h3>
          <p>Thanks for reaching out. Pete will get back to you as soon as possible.</p>
          <a href="/" class="form-submit thank-you-home">Back to Home</a>
        </div>
      </div>
    </section>

    <section class="map-section">
      <div class="container">
        <h2>Find Us on the Map</h2>
        <div class="map-container">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3094.8!2d-84.6!3d39.15!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2s6441+Glenway+Ave%2C+Cincinnati%2C+OH+45211!5e0!3m2!1sen!2sus!4v1"
            width="100%" 
            height="450" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>
      </div>
    </section>

    <section class="features-section">
      <div class="container">
        <h2>What Makes JTAPS Special</h2>
        <div class="features-grid">
          <div class="feature-card">
            <span class="icon">🌳</span>
            <h3>Outdoor Dining</h3>
            <p>Enjoy your meal on our spacious outdoor patio</p>
          </div>
          <div class="feature-card">
            <span class="icon">📺</span>
            <h3>50+ TVs</h3>
            <p>Never miss a moment of the game</p>
          </div>
          <div class="feature-card">
            <span class="icon">🎰</span>
            <h3>Sports Betting</h3>
            <p>Live sports betting available</p>
          </div>
          <div class="feature-card">
            <span class="icon">👨‍👩‍👧‍👦</span>
            <h3>Family Friendly</h3>
            <p>Great atmosphere for the whole family</p>
          </div>
          <div class="feature-card">
            <span class="icon">🍺</span>
            <h3>Craft Beer</h3>
            <p>Rotating seasonal taps</p>
          </div>
          <div class="feature-card">
            <span class="icon">🎵</span>
            <h3>Live Music</h3>
            <p>Check our schedule for events</p>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-section">
      <h2>Ready to Visit?</h2>
      <p>Come experience the best sports bar in Cincinnati</p>
      <div class="cta-buttons">
        <a href="/menu" class="cta-button">View Menu</a>
        <a href="https://togoorder.com/web/3136#/" target="_blank" class="cta-button secondary">Order Online</a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .contact-page {
    background: var(--bg-light);
  }

  .contact-hero {
    background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('/images/restaurant-exterior.jpg') center/cover;
    color: var(--text-light);
    text-align: center;
    padding: 6rem 2rem 4rem;
  }

  .contact-hero h1 {
    font-size: 4rem;
    color: var(--secondary-color);
    margin-bottom: 1rem;
  }

  .subtitle {
    font-size: 1.2rem;
    letter-spacing: 2px;
  }

  .contact-info {
    padding: 6rem 2rem;
    background: white;
  }

  .contact-form-section {
    padding: 6rem 2rem;
    background: linear-gradient(180deg, #fff8f3 0%, #ffffff 100%);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .contact-form-layout {
    display: grid;
    grid-template-columns: minmax(280px, 0.9fr) minmax(320px, 1.1fr);
    gap: 2rem;
    align-items: start;
  }

  .contact-form-copy {
    padding: 1rem 0;
  }

  .eyebrow {
    display: inline-block;
    margin: 0 0 1rem;
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--secondary-color);
    font-weight: 700;
  }

  .contact-form-copy h2 {
    font-size: 2.5rem;
    color: var(--primary-color);
    margin-bottom: 1rem;
  }

  .contact-form-copy p {
    line-height: 1.8;
    color: #333;
    max-width: 34rem;
  }

  .contact-points {
    margin: 1.5rem 0 0;
    padding-left: 1.2rem;
    color: #444;
    line-height: 1.8;
  }

  .contact-form {
    background: white;
    border-radius: 18px;
    padding: 2rem;
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.12);
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    font-weight: 600;
    color: var(--primary-color);
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #d9d9d9;
    border-radius: 12px;
    padding: 0.95rem 1rem;
    font: inherit;
    font-size: 1rem; /* prevent iOS auto-zoom (must be >= 16px rendered) */
    background: #fff;
    color: #222;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .contact-form textarea {
    resize: vertical;
    min-height: 120px;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: none;
    border-color: var(--secondary-color);
    box-shadow: 0 0 0 4px rgba(225, 54, 34, 0.12);
  }

  .message-field {
    margin-top: 1rem;
  }

  .form-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-status {
    min-height: 1.5rem;
    margin: 1rem 0 0;
    font-weight: 600;
  }

  .form-submit {
    margin-top: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    border: 0;
    border-radius: 12px;
    background: var(--secondary-color);
    color: white;
    padding: 1rem 1.25rem;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .form-submit:hover {
    transform: translateY(-1px);
  }

  .form-submit:disabled {
    opacity: 0.7;
    cursor: wait;
    transform: none;
  }

  .thank-you-state {
    grid-column: 2;
    background: white;
    border-radius: 18px;
    padding: 3rem 2rem;
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.12);
    border: 1px solid rgba(0, 0, 0, 0.06);
    text-align: center;
  }

  .thank-you-icon {
    font-size: 3rem;
    display: block;
    margin-bottom: 1rem;
  }

  .thank-you-state h3 {
    font-size: 2rem;
    color: var(--primary-color);
    margin-bottom: 0.75rem;
  }

  .thank-you-state p {
    color: #444;
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .thank-you-home {
    display: inline-flex;
    text-decoration: none;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .info-card {
    background: var(--bg-light);
    padding: 2rem;
    border-radius: 10px;
    border-top: 4px solid var(--secondary-color);
  }

  .info-card.highlight {
    background: var(--primary-color);
    color: var(--text-light);
  }

  .info-card h2 {
    font-size: 1.8rem;
    margin-bottom: 1rem;
    color: var(--primary-color);
  }

  .info-card.highlight h2 {
    color: var(--secondary-color);
  }

  .info-card p {
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .info-card a {
    color: var(--secondary-color);
    text-decoration: none;
  }

  .info-card a:hover {
    text-decoration: underline;
  }

  .map-button {
    display: inline-block;
    background: var(--secondary-color);
    color: white !important;
    padding: 0.8rem 2rem;
    border-radius: 5px;
    margin-top: 1rem;
    transition: transform 0.3s;
  }

  .map-button:hover {
    transform: translateY(-2px);
    text-decoration: none !important;
  }

  .social-links {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
  }

  .social-links a {
    background: var(--primary-color);
    color: white !important;
    padding: 0.5rem 1rem;
    border-radius: 5px;
  }

  .hours-note {
    font-size: 0.9rem;
    font-style: italic;
    color: #666;
  }

  .map-section {
    padding: 4rem 2rem;
    background: white;
  }

  .map-section h2 {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 2rem;
    color: var(--primary-color);
  }

  .map-container {
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  }

  .features-section {
    padding: 6rem 2rem;
    background: var(--bg-light);
  }

  .features-section h2 {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 3rem;
    color: var(--primary-color);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .feature-card {
    background: white;
    padding: 2rem;
    border-radius: 10px;
    text-align: center;
    transition: transform 0.3s;
  }

  .feature-card:hover {
    transform: translateY(-5px);
  }

  .icon {
    font-size: 3rem;
    display: block;
    margin-bottom: 1rem;
  }

  .feature-card h3 {
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
    color: var(--primary-color);
  }

  .cta-section {
    background: var(--primary-color);
    color: var(--text-light);
    text-align: center;
    padding: 6rem 2rem;
  }

  .cta-section h2 {
    font-size: 3rem;
    color: var(--secondary-color);
    margin-bottom: 1rem;
  }

  .cta-section p {
    font-size: 1.2rem;
    margin-bottom: 2rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-button {
    display: inline-block;
    background: var(--secondary-color);
    color: white;
    padding: 1.2rem 3rem;
    text-decoration: none;
    font-weight: bold;
    border-radius: 5px;
    transition: transform 0.3s;
  }

  .cta-button:hover {
    transform: translateY(-2px);
  }

  .cta-button.secondary {
    background: rgba(255,255,255,0.1);
  }

  .form-status.success {
    color: #146c2e;
  }

  .form-status.error {
    color: #b42318;
  }

  @media (max-width: 768px) {
    .contact-hero {
      padding: 4rem 1.25rem 3rem;
    }

    .contact-hero h1 {
      font-size: 2.5rem;
    }

    .contact-info,
    .contact-form-section,
    .features-section,
    .cta-section {
      padding: 3rem 1.25rem;
    }

    .map-section {
      padding: 2.5rem 1.25rem;
    }

    .info-grid {
      grid-template-columns: 1fr;
    }

    .info-card {
      padding: 1.5rem;
    }

    .features-section h2,
    .map-section h2,
    .cta-section h2 {
      font-size: 2rem;
    }

    /* Stack the two-column form layout */
    .contact-form-layout {
      grid-template-columns: 1fr;
    }

    /* On mobile, show the copy block above the form but keep it compact */
    .contact-form-copy {
      padding: 0;
    }

    .contact-form-copy h2 {
      font-size: 1.75rem;
    }

    .contact-points {
      display: none; /* hide the bullet list to keep the form front and center */
    }

    /* Stack the 2-col name/email/phone/subject grid */
    .form-grid {
      grid-template-columns: 1fr;
    }

    .contact-form {
      padding: 1.5rem 1.25rem;
      border-radius: 14px;
    }

    /* Thank-you card: reset grid-column so it fills the single column */
    .thank-you-state {
      grid-column: 1;
      padding: 2rem 1.25rem;
    }

    /* Make the submit button easier to tap */
    .form-submit {
      padding: 1.1rem 1.25rem;
      font-size: 1rem;
      min-height: 52px;
    }

    /* Wider touch target for map button */
    .map-button {
      display: block;
      text-align: center;
    }

    /* Stack CTA buttons full-width */
    .cta-buttons {
      flex-direction: column;
      align-items: stretch;
    }

    .cta-button {
      text-align: center;
      padding: 1rem 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .contact-hero h1 {
      font-size: 2rem;
    }

    .contact-form-section {
      padding: 2.5rem 1rem;
    }

    .contact-form {
      padding: 1.25rem 1rem;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-form-status');
  const thankYou = document.getElementById('contact-thank-you');

  if (form && status) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      status.className = 'form-status';
      status.textContent = '';

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = 'Sending...';
      }

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.error || 'Something went wrong. Please try again.');
        }

        // Show full thank-you state, hide the form
        form.closest('.contact-form-layout')?.classList.add('form-sent');
        if (thankYou) {
          thankYou.hidden = false;
          thankYou.focus();
        }
        form.hidden = true;
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'Something went wrong. Please try again.';
        status.classList.add('error');
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = 'Send Message';
        }
      }
    });
  }
</script>
