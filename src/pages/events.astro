---
import Layout from '../layouts/Layout.astro';
import '../styles/events-flyer.css';
import { supabaseAdmin } from '../lib/supabase';
import { staticUpcomingEvents, type StaticEvent } from '../data/upcomingEvents';

const title = 'Upcoming Events at JTAPS | Cincinnati Sports Bar';
const description =
  'See what is coming up at JTAPS Bar & Grill — NFL Sundays, gameday watch parties, seasonal parties, and rewards. 6441 Glenway Ave, Cincinnati.';
const ogImage = '/images/6441-Glenway.jpg';

interface GameRow {
  id: number;
  sport: string;
  league: string;
  matchup: string;
  game_date: string;
  notes: string | null;
}

interface FlyerEvent {
  id: string;
  emoji: string;
  title: string;
  when: string;
  detail: string;
  highlight?: boolean;
}

function formatGameWhen(iso: string) {
  const d = new Date(iso);
  return d.toLocaleString('en-US', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
    timeZone: 'America/New_York',
  });
}

function sportEmoji(sport: string, league: string) {
  const s = `${sport} ${league}`.toLowerCase();
  if (s.includes('football') || s.includes('nfl')) return '🏈';
  if (s.includes('basketball') || s.includes('nba') || s.includes('ncaa')) return '🏀';
  if (s.includes('hockey') || s.includes('nhl')) return '🏒';
  if (s.includes('baseball') || s.includes('mlb')) return '⚾';
  if (s.includes('soccer') || s.includes('mls')) return '⚽';
  if (s.includes('ufc') || s.includes('mma')) return '🥊';
  return '📺';
}

let calendarEvents: FlyerEvent[] = [];

if (supabaseAdmin) {
  const { data } = await supabaseAdmin
    .from('game_calendar')
    .select('id, sport, league, matchup, game_date, notes')
    .gte('game_date', new Date().toISOString())
    .order('game_date', { ascending: true })
    .limit(5);

  if (data?.length) {
    calendarEvents = (data as GameRow[]).map((g) => ({
      id: `game-${g.id}`,
      emoji: sportEmoji(g.sport, g.league),
      title: g.matchup,
      when: formatGameWhen(g.game_date),
      detail: [g.league, g.sport, g.notes].filter(Boolean).join(' · ') || 'Watch party at JTAPS',
      highlight: true,
    }));
  }
}

const staticForFlyer: FlyerEvent[] = staticUpcomingEvents.map((e: StaticEvent) => ({
  id: e.id,
  emoji: e.emoji,
  title: e.title,
  when: e.when,
  detail: e.detail,
  highlight: e.highlight,
}));

/** Calendar games first, then promos — cap so the flyer stays readable. */
const flyerEvents: FlyerEvent[] = [...calendarEvents, ...staticForFlyer].slice(0, 7);
const updatedLabel = new Date().toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
  timeZone: 'America/New_York',
});
---

<Layout title={title} description={description} ogImage={ogImage}>
  <div class="events-page">
    <section class="events-page__intro">
      <h1>Upcoming Events</h1>
      <p>
        Table-ready <strong>8.5&times;11&Prime;</strong> letter flyer — print on cardstock, trim if needed, and stand on tables.
        Use <strong>Print</strong> with scale at <strong>100%</strong> (no &ldquo;Fit to page&rdquo;). Watch parties from your admin calendar appear automatically when scheduled.
      </p>
      <div class="events-page__actions">
        <button type="button" class="events-page__btn events-page__btn--primary" onclick="window.print()">
          Print 8.5&times;11
        </button>
        <a href="/watch-the-game" class="events-page__btn">Watch the Game</a>
        <a href="https://togoorder.com/web/3136#/" target="_blank" rel="noopener" class="events-page__btn">
          Order Online
        </a>
      </div>
    </section>

    <div class="events-flyer-wrap">
      <article class="events-flyer" id="jtaps-events-flyer" aria-label="JTAPS upcoming events flyer">
        <header class="ef-brand">
          <div class="ef-brand__logo">JTAPS</div>
          <div class="ef-brand__sub">BAR &amp; GRILL</div>
        </header>
        <p class="ef-kicker">What&apos;s Coming Up</p>
        <ul class="ef-list">
          {flyerEvents.map((event) => (
            <li class={`ef-item${event.highlight ? ' ef-item--highlight' : ''}`}>
              <span class="ef-item__emoji" aria-hidden="true">{event.emoji}</span>
              <span class="ef-item__title">{event.title}</span>
              <span class="ef-item__when">{event.when}</span>
              <span class="ef-item__detail">{event.detail}</span>
            </li>
          ))}
        </ul>
        <footer class="ef-footer">
          <strong>6441 Glenway Ave</strong> · Cincinnati, OH<br />
          <a href="tel:5135749777">(513) 574-9777</a> · jtapsbarandgrill.com<br />
          <span style="opacity: 0.65;">Updated {updatedLabel}</span>
        </footer>
      </article>
    </div>
  </div>
</Layout>
