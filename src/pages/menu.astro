---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Menu - JTAPS Bar and Grill | Best Wings in Cincinnati"
  description="Hungry? Explore our famous menu: Best wings in Cincinnati, hand-carved gyros, juicy burgers & more. Order now at (513) 574-9777 or online—JTAPS delivers flavor!"
  keywords="best wings cincinnati, cincinnati wings, pete's sauce, gyros menu, burger menu cincinnati, sports bar menu, glenway ave restaurant menu"
  ogImage="/images/Cincinnati Wings.jpg"
>
  <div class="menu-page">
    <section class="menu-hero">
      <h1>Our Menu</h1>
      <p class="subtitle">CINCINNATI'S BEST WINGS, GYROS & MORE</p>
    </section>

    <!-- Sticky Category Nav -->
    <nav class="menu-nav" id="menuNav">
      <div class="menu-nav-inner">
        <a href="#wings" class="menu-nav-link active">🔥 Wings</a>
        <a href="#gyros" class="menu-nav-link">🥙 Gyros</a>
        <a href="#burgers" class="menu-nav-link">🍔 Burgers</a>
        <a href="#sandwiches" class="menu-nav-link">🥪 Sandwiches</a>
        <a href="#salads" class="menu-nav-link">🥗 Salads</a>
        <a href="#sides" class="menu-nav-link">🍟 Sides</a>
      </div>
    </nav>

    <section class="menu-section">
      <div class="menu-category" id="wings">
        <h2>🔥 Famous Wings</h2>
        <p class="category-desc">Voted Best Wings in Cincinnati - Try our Famous Pete's Sauce!</p>
        <div class="menu-items">
          <div class="menu-item popular-item">
            <span class="popular-badge">⭐ Most Popular</span>
            <img src="/images/menuitems/wings3.jpg" alt="Best wings in Cincinnati with Pete's Famous Sauce at JTAPS Bar and Grill" class="menu-image" width="600" height="350" loading="lazy" />
            <div class="item-header">
              <h3>Chicken Wings</h3>
            </div>
            <p>Our signature wings with your choice of sauce: Pete's Famous Sauce, Buffalo, BBQ, Honey BBQ, Garlic Parmesan, Teriyaki, or Dry Rub</p>
            <a href="https://togoorder.com/web/3136#/" target="_blank" class="order-now-btn">Order Now</a>
          </div>
        </div>
        <p class="category-link">🏆 <a href="/best-wings-cincinnati">Discover why we're voted #1 wings in Cincinnati →</a></p>
      </div>

      <div class="menu-category" id="gyros">
        <h2>🥙 Amazing Gyros</h2>
        <p class="category-desc">Best Gyros in Cincinnati - Hand-Carved Greek Street Food</p>
        <div class="menu-items">
          <div class="menu-item">
            <img src="/images/menuitems/gyrolamb.jpg" alt="Hand-carved lamb and beef gyro at JTAPS Cincinnati" class="menu-image" width="600" height="250" loading="lazy" />
            <div class="item-header">
              <h3>Traditional Gyro</h3>
            </div>
            <p>Hand-carved lamb and beef gyro meat, fresh tomatoes, onions, and tzatziki sauce on warm pita bread</p>
            <a href="https://togoorder.com/web/3136#/" target="_blank" class="order-now-btn">Order Now</a>
          </div>
          <div class="menu-item">
            <img src="/images/menuitems/gyrochicken.jpg" alt="Grilled chicken gyro with tzatziki at JTAPS Bar and Grill" class="menu-image" width="600" height="250" loading="lazy" />
            <div class="item-header">
              <h3>Chicken Gyro</h3>
            </div>
            <p>Grilled chicken, fresh vegetables, and tzatziki on warm pita</p>
            <a href="https://togoorder.com/web/3136#/" target="_blank" class="order-now-btn">Order Now</a>
          </div>
        </div>
      </div>

      <div class="menu-category" id="burgers">
        <h2>🍔 Juicy Burgers</h2>
        <p class="category-desc">The Juiciest Burgers in Cincinnati</p>
        <div class="menu-items">
          <div class="menu-item">
            <img src="/images/menuitems/burger.jpg" alt="Half-pound Angus cheeseburger at JTAPS sports bar Cincinnati" class="menu-image" width="600" height="250" loading="lazy" />
            <div class="item-header">
              <h3>Classic Cheeseburger</h3>
            </div>
            <p>Half-pound Angus beef, American cheese, lettuce, tomato, onion, pickles</p>
            <a href="https://togoorder.com/web/3136#/" target="_blank" class="order-now-btn">Order Now</a>
          </div>
          <div class="menu-item">
            <img src="/images/menuitems/gryomelt.jpg" alt="Gyro melt with feta cheese at JTAPS Bar and Grill" class="menu-image" width="600" height="250" loading="lazy" />
            <div class="item-header">
              <h3>Gyro Melt</h3>
            </div>
            <p>Melted gyro meat with feta cheese, onions, and tzatziki on grilled pita</p>
            <a href="https://togoorder.com/web/3136#/" target="_blank" class="order-now-btn">Order Now</a>
          </div>
        </div>
      </div>

      <div class="menu-category" id="sandwiches">
        <h2>🥪 Massive Sandwiches</h2>
        <p class="category-desc">Handheld Monuments - Not Your Average Sandwiches</p>
        <div class="menu-items">
          <div class="menu-item">
            <img src="/images/menuitems/crispychickensandwich.jpg" alt="Crispy buffalo chicken sandwich at JTAPS Cincinnati" class="menu-image" width="600" height="250" loading="lazy" />
            <div class="item-header">
              <h3>Crispy Chicken Sandwich</h3>
            </div>
            <p>Crispy chicken breast tossed in buffalo sauce with ranch and slaw</p>
            <a href="https://togoorder.com/web/3136#/" target="_blank" class="order-now-btn">Order Now</a>
          </div>
          <div class="menu-item">
            <img src="/images/menuitems/doubledecker2.jpg" alt="Classic Double Decker" class="menu-image" width="600" height="250" loading="lazy" />
            <div class="item-header">
              <h3>Classic Double Decker</h3>
            </div>
            <p>Massive double-layered sandwich with turkey, ham, bacon, lettuce, tomato, and mayo</p>
            <a href="https://togoorder.com/web/3136#/" target="_blank" class="order-now-btn">Order Now</a>
          </div>
        </div>
      </div>

      <div class="menu-category" id="salads">
        <h2>🥗 Massive Salads</h2>
        <p class="category-desc">Built Like Entrees - Premium Proteins & House-Made Dressings</p>
        <div class="menu-items">
          <div class="menu-item">
            <img src="/images/menuitems/gyrosalad.jpg" alt="Buffalo wing salad at JTAPS sports bar Cincinnati" class="menu-image" width="600" height="250" loading="lazy" />
            <div class="item-header">
              <h3>Buffalo Wing Salad</h3>
            </div>
            <p>Fresh greens, wings and wing sauce, cheese in a massive proportion</p>
            <a href="https://togoorder.com/web/3136#/" target="_blank" class="order-now-btn">Order Now</a>
          </div>
          <div class="menu-item">
            <img src="/images/menuitems/gyrosaladlamb3.jpg" alt="Greek Salad" class="menu-image" width="600" height="250" loading="lazy" />
            <div class="item-header">
              <h3>Gyro Salad</h3>
            </div>
            <p>Crisp greens, feta, olives, fresh tomatoes, cucumbers, Greek dressing</p>
            <a href="https://togoorder.com/web/3136#/" target="_blank" class="order-now-btn">Order Now</a>
