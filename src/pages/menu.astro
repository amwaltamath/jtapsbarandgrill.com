      <div class="menu-category" id="sides">
        <h2>🍟 Sides & More</h2>
        <p class="category-desc">Best Chips in Cincy - House-Fried Saratoga Chips & More</p>
        <div class="menu-items">
          <div class="menu-item">
            <img src="/images/menuitems/saratogachips.jpg" alt="Saratoga Chips" class="menu-image" width="600" height="250" loading="lazy" />
            <div class="item-header">
              <h3>Saratoga Chips</h3>
            </div>
            <p>House-fried crispy potato chips served with ranch or cheese sauce</p>
            <a href="https://togoorder.com/web/3136#/" target="_blank" class="order-now-btn">Order Now</a>
          </div>
          <div class="menu-item">
            <img src="/images/menuitems/steakfries.jpg" alt="Steak Fries" class="menu-image" width="600" height="250" loading="lazy" />
            <div class="item-header">
              <h3>Steak Fries</h3>
            </div>
            <p>Crispy golden steak-cut fries</p>
            <a href="https://togoorder.com/web/3136#/" target="_blank" class="order-now-btn">Order Now</a>
          </div>
          <div class="menu-item">
            <img src="/images/menuitems/onionrings.jpg" alt="Onion Rings" class="menu-image" width="600" height="250" loading="lazy" />
            <div class="item-header">
              <h3>Onion Rings</h3>
            </div>
            <p>Beer-battered thick-cut onion rings</p>
            <a href="https://togoorder.com/web/3136#/" target="_blank" class="order-now-btn">Order Now</a>
          </div>
          <div class="menu-item">
            <img src="/images/menuitems/greekdip.jpg" alt="Greek Dip" class="menu-image" width="600" height="250" loading="lazy" />
            <div class="item-header">
              <h3>Greek Dip</h3>
            </div>
            <p>Authentic Greek dip served with pita chips</p>
            <a href="https://togoorder.com/web/3136#/" target="_blank" class="order-now-btn">Order Now</a>
          </div>
          <div class="menu-item">
            <img src="/images/menuitems/cheesesticks.jpg" alt="Cheese Sticks" class="menu-image" width="600" height="250" loading="lazy" />
            <div class="item-header">
              <h3>Cheese Sticks</h3>
            </div>
            <p>Golden-fried mozzarella cheese sticks with marinara</p>
            <a href="https://togoorder.com/web/3136#/" target="_blank" class="order-now-btn">Order Now</a>
          </div>
          <div class="menu-item">
            <img src="/images/menuitems/potatoskins2.jpg" alt="Potato Skins" class="menu-image" width="600" height="250" loading="lazy" />
            <div class="item-header">
              <h3>Potato Skins</h3>
            </div>
            <p>Crispy potato skins loaded with cheese, bacon, and sour cream</p>
            <a href="https://togoorder.com/web/3136#/" target="_blank" class="order-now-btn">Order Now</a>
          </div>
        </div>
      </div>
    </section>

    <section class="order-cta">
      <h2>Ready to Order?</h2>
      <p>Experience the best wings and gyros in Cincinnati</p>
      <a href="https://togoorder.com/web/3136#/" target="_blank" class="order-button">Order Online Now</a>
    </section>
  </div>
</Layout>

<style>
  .menu-page {
    background: var(--bg-light);
  }

  /* Sticky Category Nav */
  .menu-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--primary-color);
    border-bottom: 2px solid var(--secondary-color);
    padding: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .menu-nav-inner {
    display: flex;
    justify-content: center;
    gap: 0;
    max-width: 900px;
    margin: 0 auto;
    white-space: nowrap;
  }

  .menu-nav-link {
    color: #ccc;
    text-decoration: none;
    padding: 0.9rem 1.25rem;
    font-size: 0.9rem;
    font-weight: 600;
    transition: color 0.3s, border-bottom 0.3s;
    border-bottom: 3px solid transparent;
    display: inline-block;
  }

  .menu-nav-link:hover,
  .menu-nav-link.active {
    color: var(--secondary-color);
    border-bottom-color: var(--secondary-color);
  }

  /* Popular Item Badge */
  .popular-item {
    position: relative;
    border: 2px solid var(--secondary-color);
  }

  .popular-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: var(--secondary-color);
    color: #fff;
    padding: 0.3rem 0.75rem;
    border-radius: 15px;
    font-size: 0.75rem;
    font-weight: 700;
    z-index: 2;
    letter-spacing: 0.5px;
  }

  /* Category internal link */
  .category-link {
    margin-top: 1.5rem;
    text-align: center;
    font-size: 0.95rem;
  }

  .category-link a {
    color: var(--secondary-color);
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.3s;
    display: inline-block;
  }

  .category-link a:hover {
    transform: translateX(4px);
  }

  .menu-hero {
    background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('/images/Sides.jpg') center/cover;
    color: var(--text-light);
    text-align: center;
    padding: 8rem 2rem 6rem;
    min-height: 600px;
    height: 45vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .menu-hero h1 {
    font-size: 4rem;
    color: var(--secondary-color);
    margin-bottom: 1rem;
  }

  .subtitle {
    font-size: 1.2rem;
    color: var(--secondary-color);
    font-weight: bold;
    letter-spacing: 2px;
  }

  .menu-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  .menu-category {
    background: white;
    padding: 3rem;
    margin-bottom: 3rem;
    border-radius: 10px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.1);
  }

  .menu-category h2 {
    font-size: 2.5rem;
    color: var(--primary-color);
    margin-bottom: 0.5rem;
  }

  .category-desc {
    color: var(--secondary-color);
    font-weight: bold;
    margin-bottom: 2rem;
    font-size: 1.1rem;
  }

  .menu-items {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2.5rem;
  }

  .menu-item {
    border: 1px solid #e0e0e0;
    border-radius: 10px;
    overflow: hidden;
    background: white;
    transition: transform 0.3s, box-shadow 0.3s;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    height: 100%;
  }

  .menu-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
  }

  .menu-image {
    width: 100%;
    height: 250px;
    object-fit: cover;
    display: block;
  }

  /* Make wings image larger and show full image */
  .menu-category:first-child .menu-image {
    height: 350px;
    object-fit: contain;
    background: #f8f8f8;
  }

  .item-header {
    display: flex;
    justify-content: center;
    align-items: baseline;
    margin-bottom: 0.5rem;
    padding-top: 1rem;
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .item-header h3 {
    font-size: 1.3rem;
    color: var(--primary-color);
    text-align: center;
  }

  .price {
    font-weight: bold;
    color: var(--secondary-color);
    font-size: 1.2rem;
  }

  .menu-item p {
    color: var(--text-dark);
    line-height: 1.6;
    padding: 0 1rem;
    font-size: 0.95rem;
    flex-grow: 1;
  }

  .order-now-btn {
    display: block;
    background: var(--secondary-color);
    color: white;
    text-align: center;
    padding: 0.8rem 1.5rem;
    text-decoration: none;
    font-weight: bold;
    border-radius: 0;
    transition: background 0.3s;
    margin: 1rem 1rem 1rem 1rem;
    border-radius: 5px;
    font-size: 0.95rem;
  }

  .order-now-btn:hover {
    background: #c42e1a;
  }

  .order-cta {
    background: var(--primary-color);
    color: var(--text-light);
    text-align: center;
    padding: 6rem 2rem;
  }

  .order-cta h2 {
    font-size: 3rem;
    margin-bottom: 1rem;
    color: var(--secondary-color);
  }

  .order-cta p {
    font-size: 1.2rem;
    margin-bottom: 2rem;
  }

  .order-button {
    display: inline-block;
    background: var(--secondary-color);
    color: white;
    padding: 1.2rem 3rem;
    text-decoration: none;
    font-weight: bold;
    border-radius: 5px;
    font-size: 1.1rem;
    transition: transform 0.3s;
  }

  .order-button:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .menu-hero {
      padding: 5rem 1rem 3rem;
      min-height: 250px;
      height: 30vh;
    }
    .menu-hero h1 {
      font-size: 2.2rem;
    }
    .subtitle {
      font-size: 1rem;
    }
    .menu-category {
      padding: 2rem 1.5rem;
    }

    .menu-category h2 {
      font-size: 2rem;
    }

    .item-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 480px) {
    .menu-hero {
      padding: 3rem 0.5rem 2rem;
      min-height: 180px;
      height: 22vh;
    }
    .menu-hero h1 {
      font-size: 1.5rem;
    }
    .subtitle {
      font-size: 0.9rem;
    }
  }
</style>

<script>
  // Scroll-spy for sticky menu nav
  const sections = document.querySelectorAll('.menu-category');
  const navLinks = document.querySelectorAll('.menu-nav-link');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        navLinks.forEach(link => link.classList.remove('active'));
        const activeLink = document.querySelector(`.menu-nav-link[href="#${entry.target.id}"]`);
        if (activeLink) activeLink.classList.add('active');
      }
    });
  }, { threshold: 0.3, rootMargin: '-100px 0px -50% 0px' });

  sections.forEach(section => { if (section.id) observer.observe(section); });

  // Smooth scroll for nav links
  navLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = link.getAttribute('href')?.slice(1);
      if (targetId) {
        const target = document.getElementById(targetId);
        if (target) {
          const navHeight = document.getElementById('menuNav')?.offsetHeight || 0;
          const top = target.getBoundingClientRect().top + window.scrollY - navHeight - 10;
          window.scrollTo({ top, behavior: 'smooth' });
        }
      }
    });
  });
</script>
