---
import Layout from "../layouts/Layout.astro";
import "../styles/bengals-brunch.css";
import { featuredGame, isFeaturedGameActive } from "../data/featuredGame";

const menuImage = `${featuredGame.brunchMenuImage}?v=${featuredGame.brunchMenuImageVersion}`;
const title = "Bengals vs Falcons Brunch | JTAPS Game Day Watch Party";
const description =
  "JTAPS opens at 9 AM Sunday for Bengals vs Falcons in Madrid. Mimosas, Bloody Marys, brunch menu, and 50+ TVs. 6441 Glenway Ave — call (513) 574-9777.";
const active = isFeaturedGameActive();

if (!active) {
  return Astro.redirect("/watch-the-game", 302);
}
---

<Layout
  title={title}
  description={description}
  ogImage={menuImage}
  keywords="bengals falcons watch party cincinnati, madrid nfl game brunch, jtaps brunch menu, who dey cincinnati sports bar"
  showRewardsModal={false}
>
  <div class="bengals-brunch-page">
    <section class="bb-hero">
      <div class="bb-hero-inner">
        <span class="bb-badge">Who Dey · Madrid Game</span>
        <h1>Game Day Brunch</h1>
        <p class="bb-hero-meta">
          {featuredGame.when} · Doors {featuredGame.doors} · Kickoff {featuredGame.kickoff}
        </p>
        <p class="bb-hero-sub">
          The {featuredGame.matchup} from {featuredGame.location} — watch every play at JTAPS with
          <strong>mimosas</strong>, <strong>Bloody Marys</strong>, and our special <strong>brunch menu</strong>.
        </p>
        <div class="bb-cta-row">
          <a href="tel:5135749777" class="bb-btn bb-btn--primary">Call (513) 574-9777</a>
          <a href="/watch-the-game" class="bb-btn bb-btn--ghost">Why Watch Here</a>
        </div>
      </div>
    </section>

    <section class="bb-drinks" aria-labelledby="bb-drinks-title">
      <div class="bb-drinks__inner">
        <header class="bb-drinks__header">
          <span class="bb-section-tag">Sunday Brunch Bar</span>
          <h2 id="bb-drinks-title">Mimosas &amp; Bloody Marys</h2>
          <p>Sip something brunch-worthy while you wait for kickoff — both pouring when we open at {featuredGame.doors}.</p>
        </header>
        <div class="bb-drinks__grid">
          {featuredGame.brunchDrinks.map((drink) => (
            <article class="bb-drinks__card">
              <span class="bb-drinks__emoji" aria-hidden="true">{drink.emoji}</span>
              <h3>{drink.name}</h3>
              <p>{drink.detail}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bb-menu-section" id="menu">
      <header class="bb-menu-header">
        <span class="bb-section-tag">Brunch Menu</span>
        <h2>What We&apos;re Serving</h2>
        <p>
          Arrive when we open at 9 AM — order a mimosa or Bloody Mary, then check the brunch plates before the 9:30 AM kickoff.
        </p>
      </header>

      <p class="bb-menu-tap-hint">Tap the menu to view full size</p>
      <figure class="bb-menu-frame">
        <button
          type="button"
          class="bb-menu-zoom-trigger"
          data-menu-zoom-open
          aria-label="Open brunch menu full size"
        >
          <img
            src={menuImage}
            alt="JTAPS brunch menu for Bengals vs Falcons game day — mimosas, Bloody Marys, and brunch items"
            width="1200"
            height="1600"
            loading="eager"
          />
          <span class="bb-menu-zoom-badge" aria-hidden="true">Tap to enlarge</span>
        </button>
      </figure>

      <div class="bb-menu-lightbox" data-menu-lightbox aria-hidden="true">
        <button
          type="button"
          class="bb-menu-lightbox__backdrop"
          data-menu-zoom-close
          aria-label="Close full size menu"
        ></button>
        <div class="bb-menu-lightbox__panel" role="dialog" aria-modal="true" aria-label="Brunch menu full size">
          <button type="button" class="bb-menu-lightbox__close" data-menu-zoom-close aria-label="Close">
            ✕
          </button>
          <div class="bb-menu-lightbox__scroll">
            <img src={menuImage} alt="" width="1200" height="1600" />
          </div>
        </div>
      </div>

      <div class="bb-details">
        <div class="bb-detail-card reveal-on-scroll">
          <strong>{featuredGame.doors}</strong>
          Doors open
        </div>
        <div class="bb-detail-card reveal-on-scroll">
          <strong>{featuredGame.kickoff}</strong>
          Kickoff
        </div>
        <div class="bb-detail-card reveal-on-scroll">
          <strong>50+</strong>
          HD TVs
        </div>
        <div class="bb-detail-card reveal-on-scroll">
          <strong>$15</strong>
          Beer buckets — Who Dey Day
        </div>
      </div>
    </section>

    <section class="bb-footer-cta">
      <h2>6441 Glenway Ave · Cincinnati</h2>
      <p>Family-owned sports bar · famous wings · the best seat for Who Dey Sunday.</p>
      <div class="bb-cta-row">
        <a href="tel:5135749777" class="bb-btn bb-btn--ghost">Reserve by Phone</a>
        <a href="/specials" class="bb-btn bb-btn--ghost">Weekly Specials</a>
      </div>
    </section>
  </div>
</Layout>

<script is:inline>
  (function () {
    function initMenuLightbox() {
      const lightbox = document.querySelector("[data-menu-lightbox]");
      const openBtn = document.querySelector("[data-menu-zoom-open]");
      if (!lightbox || !openBtn) return;

      if (lightbox.parentElement !== document.body) {
        document.body.appendChild(lightbox);
      }

      const closeEls = lightbox.querySelectorAll("[data-menu-zoom-close]");

      function openLightbox() {
        lightbox.classList.add("is-open");
        lightbox.setAttribute("aria-hidden", "false");
        document.body.classList.add("bb-menu-lightbox-open");
      }

      function closeLightbox() {
        lightbox.classList.remove("is-open");
        lightbox.setAttribute("aria-hidden", "true");
        document.body.classList.remove("bb-menu-lightbox-open");
      }

      openBtn.addEventListener("click", (e) => {
        e.preventDefault();
        openLightbox();
      });

      closeEls.forEach((el) => el.addEventListener("click", closeLightbox));

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && lightbox.classList.contains("is-open")) {
          closeLightbox();
        }
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initMenuLightbox);
    } else {
      initMenuLightbox();
    }
  })();
</script>
