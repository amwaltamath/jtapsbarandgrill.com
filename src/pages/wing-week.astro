---
import Layout from '../layouts/Layout.astro';
import '../styles/wing-week.css';

const title = 'Cincinnati Wing Week at JTAPS | 7 Wings for $8';
const description = 'JTAPS is participating in Cincinnati Wing Week August 24–30, 2026. Any 7 wings for $8 — your choice of sauce. Celery and dressing not included. Dine in at 6441 Glenway Ave or order online!';
const ogImage = '/images/Cincinnati Wings.jpg';
---

<Layout title={title} description={description} ogImage={ogImage} keywords="cincinnati wing week, wing week cincinnati, best wings cincinnati, jtaps wings, pete's sauce, cincy wing week, glenway ave wings">
  <div class="wing-week-page">
    <div class="ww-scene" aria-hidden="true">
      <div class="ww-scene__blob ww-scene__blob--1"></div>
      <div class="ww-scene__blob ww-scene__blob--2"></div>
      <div class="ww-scene__blob ww-scene__blob--3"></div>
    </div>

    <section class="ww-hero">
      <div class="ww-hero-bg"></div>
      <div class="ww-hero-content ww-glass ww-glass--liquid ww-hero-glass">
        <span class="ww-badge ww-glass ww-glass--accent">🍗 Cincinnati Wing Week</span>
        <p class="ww-dates">August 24 – 30, 2026</p>
        <h1>7 Wings for $8</h1>
        <p class="ww-hero-sub">
          Cincinnati Wing Week at JTAPS — pick <strong>any 7 wings</strong> for <strong>$8</strong> with your choice of sauce.
          Pete's Famous, Buffalo, BBQ, and more. <em>Celery and dressing not included.</em>
        </p>
        <div class="ww-hero-cta">
          <a href="https://togoorder.com/web/3136#/" target="_blank" rel="noopener" class="ww-glass ww-btn ww-btn--primary">Order Online</a>
          <a href="tel:5135749777" class="ww-glass ww-btn ww-btn--ghost">Call (513) 574-9777</a>
        </div>
      </div>
      <div class="ww-scroll-hint" aria-hidden="true">
        <span>Scroll</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
      </div>
    </section>

    <section class="ww-proof">
      <div class="ww-proof-container">
        <div class="ww-glass ww-glass-card ww-proof-item reveal-on-scroll">
          <span class="ww-proof-number">$8</span>
          <span class="ww-proof-label">7 Wings</span>
        </div>
        <div class="ww-glass ww-glass-card ww-proof-item reveal-on-scroll">
          <span class="ww-proof-number">Any</span>
          <span class="ww-proof-label">Sauce Choice</span>
        </div>
        <div class="ww-glass ww-glass-card ww-proof-item reveal-on-scroll">
          <span class="ww-proof-number">7</span>
          <span class="ww-proof-label">Days Only</span>
        </div>
        <div class="ww-glass ww-glass-card ww-proof-item reveal-on-scroll">
          <span class="ww-proof-number">11–10</span>
          <span class="ww-proof-label">Open Daily</span>
        </div>
      </div>
    </section>

    <section class="ww-showcase">
      <div class="ww-showcase-container">
        <div class="ww-glass ww-glass--bright ww-showcase-flyer reveal-on-scroll">
          <img
            src="/images/Cincinnati Wings.jpg"
            alt="Pete's Famous Sauce wings at JTAPS — Cincinnati Wing Week special"
            width="700"
            height="500"
            loading="lazy"
          />
        </div>
        <div class="ww-glass ww-glass--liquid ww-showcase-text reveal-on-scroll">
          <span class="ww-section-tag">WING WEEK DEAL</span>
          <h2>Any 7 Wings — Your Sauce, Your Way</h2>
          <p>
            JTAPS has been serving Cincinnati's favorite wings since 2006. For Wing Week, keep it simple:
            any 7 wings for $8 with your choice of our house-made sauces.
          </p>
          <ul class="ww-wing-specs">
            <li><strong>7 wings for $8</strong> — all week, August 24–30</li>
            <li><strong>Your choice of sauce:</strong> Pete's Famous, Buffalo, BBQ, Honey BBQ, Garlic Parmesan, Teriyaki, or Dry Rub</li>
            <li><strong>Dine-in or takeout</strong> at 6441 Glenway Ave</li>
            <li><strong>Celery and dressing not included</strong> on the Wing Week special</li>
          </ul>
          <div class="ww-price-tag">
            <span class="ww-price-amount">$8</span>
            <span class="ww-price-note">Any 7 wings · Aug 24–30 · No celery or dressing included</span>
          </div>
          <a href="/menu#wings" class="ww-btn-text">See our full wings menu →</a>
        </div>
      </div>
    </section>

    <section class="ww-pairings">
      <div class="ww-pairings-inner">
        <h2 class="ww-section-title reveal-on-scroll">Perfect Pairings</h2>
        <p class="ww-section-subtitle reveal-on-scroll">Featured sponsors of Cincinnati Wing Week — grab a cold one with your wings</p>
        <div class="ww-pairings-grid">
          <div class="ww-glass ww-glass-card ww-pairing-card reveal-on-scroll">
            <span class="ww-pairing-icon">🍺</span>
            <h3>Samuel Adams — $6</h3>
            <p>Our official Wing Week beer special. Crisp, classic, and built for game day at JTAPS.</p>
          </div>
          <div class="ww-glass ww-glass-card ww-pairing-card reveal-on-scroll">
            <span class="ww-pairing-icon">🧊</span>
            <h3>Sun Cruiser Iced Tea + Vodka</h3>
            <p>Light and refreshing — a Wing Week sponsor favorite for patio weather on Glenway Ave.</p>
          </div>
          <div class="ww-glass ww-glass-card ww-pairing-card reveal-on-scroll">
            <span class="ww-pairing-icon">📺</span>
            <h3>Game Day at JTAPS</h3>
            <p>50+ HD TVs, outdoor seating, and the best sports bar atmosphere in Cincinnati. Stay awhile.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="ww-how">
      <div class="ww-how-inner">
        <h2 class="ww-section-title reveal-on-scroll">How Cincinnati Wing Week Works</h2>
        <p class="ww-section-subtitle reveal-on-scroll">Eat wings, check in, and compete to be Cincinnati's Biggest Wing Lover</p>
        <div class="ww-steps-grid">
          <div class="ww-glass ww-glass-card ww-step-card reveal-on-scroll">
            <span class="ww-step-num">1</span>
            <h3>Get the App</h3>
            <p>Download the official Cincinnati Wing Week app to map your week and track participating restaurants.</p>
          </div>
          <div class="ww-glass ww-glass-card ww-step-card reveal-on-scroll">
            <span class="ww-step-num">2</span>
            <h3>Come to JTAPS</h3>
            <p>Order any 7 wings for $8 with your favorite sauce. Soak up the game-day vibe on Glenway Ave.</p>
          </div>
          <div class="ww-glass ww-glass-card ww-step-card reveal-on-scroll">
            <span class="ww-step-num">3</span>
            <h3>Check In &amp; Share</h3>
            <p>Check in on the app to earn points. Share with <strong>#CincyWingWeek</strong> and tag <strong>@cincywingweek</strong>.</p>
          </div>
        </div>
        <p class="ww-glass ww-glass--accent ww-how-prize reveal-on-scroll">
          Check in at <strong>four participating restaurants</strong> during the week to enter a drawing for
          <strong>$300 in gift cards</strong>. The Biggest Wing Lover in Cincinnati wins <strong>$300</strong> too!
        </p>
        <a href="https://www.cincywingweek.com/" target="_blank" rel="noopener" class="ww-glass ww-btn ww-btn--ghost reveal-on-scroll">Visit cincywingweek.com →</a>
      </div>
    </section>

    <section class="ww-cta">
      <div class="ww-glass ww-glass--liquid ww-cta-content reveal-on-scroll">
        <h2>Don't Miss 7 Wings for $8</h2>
        <p>Wing Week ends August 30. Any 7 wings, your choice of sauce — celery and dressing not included. Open 11 AM to 10 PM at 6441 Glenway Ave.</p>
        <div class="ww-cta-actions">
          <a href="https://togoorder.com/web/3136#/" target="_blank" rel="noopener" class="ww-glass ww-btn ww-btn--primary">Order Online Now</a>
          <a href="tel:5135749777" class="ww-glass ww-btn ww-btn--ghost">Call (513) 574-9777</a>
        </div>
        <p class="ww-cta-address">📍 JTAPS Bar &amp; Grill — 6441 Glenway Ave, Cincinnati, OH 45211</p>
      </div>
    </section>
  </div>
</Layout>
